@model IntranetPortal.Areas.XMD.Models.EmployeesFoldersReportViewModel
<div class="container">
    <h4>Task Folders Report</h4>
    <hr />
    <div class="row mb-3">
        <form asp-area="XMD" asp-controller="Main" asp-action="FoldersReport" method="get">
            <div class="row">
                <div class="col-md-2 mb-1 text-start">
                    <a asp-area="XMD" asp-controller="Main" asp-action="Index" title="Go Back" class="btn btn-sm btn-outline-light text-dark">
                        <i class="bi bi-backspace fw-bolder" style="font-size: 1.0rem;"></i><span class="fw-bold ml-1" style="font-size: 0.9rem;">Back</span>
                    </a>
                </div>
                <div class="col-md-4 mb-1">
                    <input asp-for="sn" class="form-control fw-bold" placeholder="Enter Staff Name">
                </div>
                <div class="col-md-2 mb-1">
                    <select asp-for="vs" class="form-control fw-bold">
                        <option value="2"> All Folders </option>
                        <option value="0"> Active Folders Only</option>
                        <option value="1"> Archived Folders Only</option>
                    </select>
                </div>
                <div class="col-md-4 mb-1">
                    <span class="fw-bold">Start From: </span>
                    <input asp-for="sd" class="border-0" style="width:100px; margin-right:30px" type="date" />
                    <span class="fw-bold">End On: </span>
                    <input asp-for="ed" class="border-0" style="width:100px; margin-right:30px" type="date" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-2 mb-2">
                    <select asp-for="gd" asp-items="@ViewBag.LocationGroupList" class="form-control fw-bold">
                        <option value=""> Location Group</option>
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <select asp-for="ld" asp-items="@ViewBag.LocationList" class="form-control fw-bold">
                        <option value=""> Location </option>
                    </select>
                </div>
                <div class="col-md-3 mb-2">
                    <select asp-for="dd" asp-items="@ViewBag.DepartmentList" class="form-control fw-bold">
                        <option value=""> Department </option>
                    </select>
                </div>
                <div class="col-md-3 mb-2">
                    <select asp-for="ud" asp-items="@ViewBag.UnitList" class="form-control fw-bold">
                        <option value=""> Unit </option>
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <input type="submit" value="Search" class="btn btn-dark btn-sm text-white" />
                </div>
            </div>
        </form>
    </div>
    <div class="row">
        @if (!String.IsNullOrEmpty(ViewBag.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold">@ViewBag.ErrorMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>
    @if (Model == null || Model.FoldersList == null || Model.FoldersList.Count < 1)
    {
        <div class="alert alert-info fade show" role="alert">
            <i class="bi bi-info-circle"></i>
            <span class="fw-bold">No record was found.</span>
        </div>
    }
    else
    {
        if (Model != null && Model.FoldersList != null && Model.FoldersList.Count > 0)
        {
            if (Model.EmployeesList != null && Model.EmployeesList.Count > 0)
            {
                var employees = Model.EmployeesList;
                <div class="accordion" id="accordionExample">
                    @while (employees.Count > 0)
                    {
                        var employee = employees.First();
                        List<IntranetPortal.Base.Models.WspModels.WorkItemFolder> folders = Model.FoldersList.FindAll(x => x.OwnerId == employee.EmployeeID);
                        if (folders != null && folders.Count > 0)
                        {
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="heading_@employee.EmployeeID">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@employee.EmployeeID" aria-expanded="false" aria-controls="collapse_@employee.EmployeeID">
                                        <span class="text-dark fw-bold mr-1"><i class="bi bi-person-fill" style="font-size:1.2rem; font-weight:900;"></i> @employee.FullName</span> <span class="text-dark fw-bold"> (@folders.Count.ToString())</span>
                                    </button>
                                </h2>
                                <div id="collapse_@employee.EmployeeID" class="accordion-collapse collapse" aria-labelledby="heading_@employee.EmployeeID" data-bs-parent="#accordionExample">
                                    <div class="accordion-body">
                                        <div class="row mt-2">
                                            @foreach (var folder in folders)
                                            {
                                                @if (folder.IsArchived)
                                                {
                                                    <div class="col-md-6 col-lg-3 col-xlg-2">
                                                        <div class="text-center">
                                                            <!-- Default dropstart button -->
                                                            <div class="btn-group dropstart">
                                                                <button type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border:0px">
                                                                    <span class="fw-bold" style="font-size:1.0rem;"><i class="bi bi-three-dots"></i></span>
                                                                </button>
                                                                <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                                                    <li>
                                                                        <a class="dropdown-item" asp-area="XMD" asp-controller="Main" asp-action="FolderTaskList" asp-route-id="@folder.Id" asp-route-fn="@folder.Title" asp-route-od="@folder.OwnerId">
                                                                            <i class="bi bi-list-task"></i> <span>Tasks</span>
                                                                        </a>
                                                                    </li>
                                                                    <li>
                                                                        <a class="dropdown-item" asp-area="XMD" asp-controller="Main" asp-action="FolderEvaluations" asp-route-id="@folder.Id" asp-route-fn="@folder.Title" asp-route-od="@folder.OwnerId">
                                                                            <i class="bi bi-list-check"></i> <span>Results</span>
                                                                        </a>
                                                                    </li>
                                                                    <li>
                                                                        <a class="dropdown-item" asp-area="WSP" asp-controller="Workspace" asp-action="TaskFolderInfo" asp-route-id="@folder.Id">
                                                                            <i class="bi bi-info-circle"></i>  <span>Detail</span>
                                                                        </a>
                                                                    </li>
                                                                    <li>
                                                                        <a class="dropdown-item" asp-area="WSP" asp-controller="Workspace" asp-action="Notes" asp-route-fd="@folder.Id" asp-route-sp="xfr">
                                                                            <i class="bi bi-stickies"></i> <span>Notes</span>
                                                                        </a>
                                                                    </li>
                                                                    <li>
                                                                        <a class="dropdown-item" asp-area="WSP" asp-controller="Workspace" asp-action="Activities" asp-route-fd="@folder.Id">
                                                                            <i class="bi bi-file-text"></i> <span>History</span>
                                                                        </a>
                                                                    </li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                        <div class="card card-hover">
                                                            <div class="box bg-light text-center">
                                                                <a asp-area="XMD" asp-controller="Main" asp-action="FolderTaskList" asp-route-id="@folder.Id" asp-route-fn="@folder.Title" asp-route-od="@folder.OwnerId">
                                                                    <h1 class="font-light text-dark" title="@folder.Title">
                                                                        <i class="bi bi-archive" style="font-size:2.5rem"></i>
                                                                    </h1>
                                                                    <div><span class="text-dark fw-bold">@folder.Title</span></div>
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>

                                                }
                                                else
                                                {
                                                    <div class="col-md-6 col-lg-3 col-xlg-2">
                                                        <div class="text-center">
                                                            <!-- Default dropstart button -->
                                                            <div class="btn-group dropstart">
                                                                <button type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border:0px">
                                                                    <span class="fw-bold" style="font-size:1.0rem;"><i class="bi bi-three-dots"></i></span>
                                                                </button>
                                                                <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                                                    <li>
                                                                        <a class="dropdown-item" asp-area="XMD" asp-controller="Main" asp-action="FolderTaskList" asp-route-id="@folder.Id" asp-route-fn="@folder.Title" asp-route-od="@folder.OwnerId">
                                                                            <i class="bi bi-list-task"></i> <span>Tasks</span>
                                                                        </a>
                                                                    </li>
                                                                    <li>
                                                                        <a class="dropdown-item" asp-area="XMD" asp-controller="Main" asp-action="TaskFolderInfo" asp-route-id="@folder.Id">
                                                                            <i class="bi bi-info-circle"></i>  <span>Detail</span>
                                                                        </a>
                                                                    </li>
                                                                    <li>
                                                                        <a class="dropdown-item" asp-area="WSP" asp-controller="Workspace" asp-action="Notes" asp-route-fd="@folder.Id" asp-route-sp="xmd">
                                                                            <i class="bi bi-stickies"></i> <span>Notes</span>
                                                                        </a>
                                                                    </li>
                                                                    <li>
                                                                        <a class="dropdown-item" asp-area="WSP" asp-controller="Workspace" asp-action="Activities" asp-route-fd="@folder.Id">
                                                                            <i class="bi bi-file-text"></i> <span>History</span>
                                                                        </a>
                                                                    </li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                        <div class="card card-hover">
                                                            <a asp-area="XMD" asp-controller="Main" asp-action="FolderTaskList" asp-route-id="@folder.Id" asp-route-fn="@folder.Title">
                                                                <div class="box bg-light text-center">
                                                                    <h1 class="font-light text-dark" title="@folder.Title"><i class="mdi mdi-folder-outline" style="font-size:2.7rem"></i></h1>
                                                                    <h6 class="text-dark">@folder.Title</h6>
                                                                </div>
                                                            </a>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        employees.RemoveAt(0);
                    }
                </div>
            }
        }
    }
</div>
@section Scripts{
    <script src="~/js/js_erm/erm_employees.js"></script>
}

