@model IntranetPortal.Areas.XMD.Models.ProjectListViewModel
@{
    ViewData["Title"] = "OfficeManager | Executive Management Dashboard";
}
<div class="container">
    <div class="row">
        <div class="col-md-12 fw-bold"><span style="font-size:1.0rem">Executive Management Projects</span></div>
    </div>
    <hr />
    <div class="row">
        <div class="col-md-12">
            <nav class="navbar navbar-expand-lg navbar-light bg-light">
                <div class="container-fluid">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNavDropdown">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a asp-area="XMD" asp-controller="Main" asp-action="Index" title="Go Back" class="btn btn-sm btn-outline-light text-dark">
                                    <i class="bi bi-backspace" style="font-size: 1.0rem;"></i> <span class="fw-bold ml-1" style="font-size: 0.9rem;">Back</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="XMD" asp-controller="Main" asp-action="ManageXmProject" asp-route-id="0" title="New Project" class="btn btn-sm btn-light text-dark">
                                    <i class="bi bi-plus-lg" style="font-size: 1.0rem;"></i><span class="fw-bold ml-1" style="font-size: 0.9rem;">New Project</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
    </div>
    <div class="row">
        @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>
    @if (Model == null || Model.ProjectList == null || Model.ProjectList.Count < 1)
    {
        <div class="alert alert-info fade show" role="alert">
            <i class="bi bi-info-circle"></i>
            <span class="fw-bold">No record was found.</span>
        </div>
    }
    else
    {
        <div class="table-responsive">
            @foreach (var project in Model.ProjectList)
            {
                <div class="card">
                        <div class="card-header" style="background-color:#034040">
                            <div class="row">
                                <div class="col-md-12">
                                    <span class="fw-bold text-white">[@project.ProjectCode]</span>
                                </div>
                            </div>
                        </div>
                    <div class="card-body table-secondary">
                        <div class="row">
                            <div class="col-md-9 mb-3">
                                <label class="form-label text-dark">Title</label>
                                <div class="form-control fw-bold">@project.ProjectTitle</div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label text-dark">Status</label>
                                @if (project.ProgressStatusId == (int)WorkItemProgressStatus.OnHold)
                                {
                                    <div class="form-control fw-bold" style="background-color:#806E01; color:white">@project.ProgressStatusDescription</div>
                                }
                                else if (project.ProgressStatusId == (int)WorkItemProgressStatus.InProgress)
                                {
                                    <div class="form-control fw-bold" style="background-color:#026630; color:white">@project.ProgressStatusDescription</div>
                                }
                                else if (project.ProgressStatusId == (int)WorkItemProgressStatus.Completed)
                                {
                                    <div class="form-control fw-bold" style="background-color:#450152; color:white">@project.ProgressStatusDescription</div>
                                }
                                else
                                {
                                    <div class="form-control fw-bold bg-info" style="color:white">@project.ProgressStatusDescription</div>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(project.ProjectDetails))
                        {
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label text-dark">Details</label>
                            <textarea class="form-control fw-bold" rows="5" readonly>@project.ProjectDetails</textarea>
                        </div>
                        </div>
                        }

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label text-dark">Expected Start Date</label>
                                @if (project.ExpectedStartTime != null)
                                {
                                    <div class="form-control fw-bold">@project.ExpectedStartTime.Value.ToString("dd-MMM-yyyy")</div>
                                }
                                else
                                {
                                    <div class="form-control fw-bold">[Not Specified]</div>
                                }
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label text-dark">Actual Start Date</label>
                                @if (project.ActualStartTime != null)
                                {
                                    <div class="form-control fw-bold">@project.ActualStartTime.Value.ToString("dd-MMM-yyyy")</div>
                                }
                                else
                                {
                                    <div class="form-control fw-bold">[Not Specified]</div>
                                }
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label text-dark">Expected Completion Date</label>
                                @if (project.ExpectedEndTime != null)
                                {
                                    <div class="form-control fw-bold">@project.ExpectedEndTime.Value.ToString("dd-MMM-yyyy")</div>
                                }
                                else
                                {
                                    <div class="form-control fw-bold">[Not Specified]</div>
                                }
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label text-dark">Actual Completion Date</label>
                                @if (project.ActualEndTime != null)
                                {
                                    <div class="form-control fw-bold">@project.ActualEndTime.Value.ToString("dd-MMM-yyyy")</div>
                                }
                                else
                                {
                                    <div class="form-control fw-bold">[Not Specified]</div>
                                }
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <a asp-area="XMD" asp-controller="Main" asp-action="ProjectTasks" asp-route-id="@project.ProjectId" asp-route-od="@project.ProjectOwnerId" class="btn btn-sm" style="border-radius: 5px; margin-right: 2px; background-color:#034040" title="Open Task List">
                                    <i class="bi bi-list-task" style="font-size:0.8rem; margin-right:2px; color:white"></i> <span class="text-white" style="font-size:0.8rem">Manage Tasks</span>
                                </a>
                                <!-- Default dropstart button -->
                                <div class="btn-group dropend">
                                    <button type="button" data-bs-toggle="dropdown" aria-expanded="false" class="btn btn-sm" style="border-radius:5px; background-color:#034040" >
                                        <i class="bi bi-tools" style="font-size:0.8rem; margin-right:2px; color:white"></i> <span style="font-size:0.8rem; color:white"> More Options</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                        <li>
                                            <a class="dropdown-item" asp-area="WSP" asp-controller="Workspace" asp-action="TaskDetails" asp-route-id="@project.ProjectId">
                                                <i class="bi bi-info-circle"></i>  <span>Detail</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="XMD" asp-controller="Main" asp-action="ManageXmProject" asp-route-id="@project.ProjectId" asp-route-od="@project.ProjectOwnerId">
                                                <i class="bi bi-pencil-fill"></i> <span>Edit</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="XMD" asp-controller="Main" asp-action="Notes" asp-route-id="@project.ProjectId" asp-route-sp="pjl">
                                                <i class="bi bi-stickies"></i> <span>Notes</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="XMD" asp-controller="Main" asp-action="history" asp-route-pd="@project.ProjectId">
                                                <i class="bi bi-file-text"></i> <span>History</span>
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        @if (project.IsClosed)
                                        {
                                            <li>
                                                <button class="dropdown-item" onclick="ReopenTaskItem('@project.ProjectId')">
                                                    <i class="bi bi-bootstrap-reboot"></i> <span>Re-Open</span>
                                                </button>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <button class="dropdown-item" onclick="closeTaskItem('@project.ProjectId')">
                                                    <i class="bi bi-x-circle"></i> <span>Close</span>
                                                </button>
                                            </li>
                                        }
                                        <li>
                                            <button class="dropdown-item" id="btn_delete_@project.ProjectId" onclick="deleteProject('@project.ProjectId')">
                                                <i class="bi bi-trash"></i> <span> Delete</span>
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                                @*<button class="btn btn-sm" style="border-radius:5px; width:100px; background-color:#5C039A" title="Click to Approve Task" onclick="approveTaskItem('@project.ProjectId')">
            <i class="bi bi-check-lg" style="font-size:0.8rem; margin-right:2px; color:white"></i> <span class="text-white" style="font-size:0.8rem">Approve</span>
        </button>*@
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
@section Scripts{
    <script src="~/js/wsp.js"></script>
}
