@model IntranetPortal.Areas.XMD.Models.XmReassignTaskViewModel
<h4>Executive Management Dashboard | Reassign Task</h4>
<hr />
<div class="card mt-1" style="width:70pc">
    <div class="card-header bg-info">
        <div class="row">
            <div class="col-md-12"><h4 class="text-white">Reassign Task</h4></div>
        </div>
    </div>
    <div class="card-body table-secondary">
        @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!String.IsNullOrEmpty(Model.ViewModelSuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i>
                <span class="fw-bold">@Model.ViewModelSuccessMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!String.IsNullOrEmpty(Model.ViewModelWarningMessage))
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle"></i>
                <span class="fw-bold">@Model.ViewModelWarningMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <form asp-area="XMD" asp-controller="Main" asp-action="XmReassignTask" method="post" autocomplete="off">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label text-dark fw-bold">Reassigned To: </label>
                    <input id="sn" asp-for="DelegatedToEmployeeName" class="form-control fw-bold" autofocus>
                    <div><span asp-validation-for="DelegatedToEmployeeName" class="text-danger"></span></div>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label text-dark fw-bold">Reassigned By: </label>
                    <input asp-for="DelegatedByEmployeeName" class="form-control fw-bold" readonly>
                    <div><span asp-validation-for="DelegatedByEmployeeName" class="text-danger"></span></div>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label text-dark fw-bold">Time Reassigned: </label>
                    @if (Model.DelegatedTime != null)
                    {
                        <div class="form-control fw-bold">@Model.DelegatedTime.Value.ToString("dd-MMM-yyyy")  @Model.DelegatedTime.Value.ToShortTimeString()</div>
                    }
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label text-dark fw-bold">Task No.</label>
                    <input asp-for="TaskNumber" class="form-control fw-bold" readonly>
                    <div><span asp-validation-for="TaskNumber" class="text-danger"></span></div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label text-dark fw-bold">Status</label>
                    <select asp-for="ProgressStatusId" class="form-control fw-bold">
                        <option value="0">Not Started</option>
                        <option value="1">In Progress</option>
                        <option value="2">Completed</option>
                        <option value="3">On Hold</option>
                    </select>
                    <div><span asp-validation-for="ProgressStatusId" class="text-danger"></span></div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label text-dark fw-bold">Start Date</label>
                    <input asp-for="ExpectedStartTime" class="form-control fw-bold" type="date">
                    <div><span asp-validation-for="ExpectedStartTime" class="text-danger"></span></div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label text-dark fw-bold">Completion Date</label>
                    <input asp-for="ExpectedDueTime" class="form-control fw-bold" type="date">
                    <div><span asp-validation-for="ExpectedDueTime" class="text-danger"></span></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 mb-2">
                    <label class="form-label text-dark fw-bold">Description</label>
                    <textarea asp-for="TaskItemDescription" class="form-control fw-bold">@Model.TaskItemDescription</textarea>
                    <div><span asp-validation-for="TaskItemDescription" class="text-danger"></span></div>
                </div>
            </div>
            @*<div class="row">
                <div class="col-md-12 mb-2">
                    <label class="form-label text-dark fw-bold">Resolution</label>
                    <textarea asp-for="MoreInformation" class="form-control fw-bold">@Model.MoreInformation</textarea>
                    <div><span asp-validation-for="MoreInformation" class="text-danger"></span></div>
                </div>
            </div>*@
            <div class="row">
                <div class="col-md-12 text-end">
                    @if (Model.SourcePage == "pjt")
                    {
                        <a asp-area="XMD" asp-controller="Main" asp-action="ProjectTasks" asp-route-id="@Model.LinkProjectId" class="btn btn-dark" style="width:75px; margin-top:30px" title="Back">
                            <span class="text-white">Back</span>
                        </a>
                    }
                    else
                    {
                        <a asp-area="XMD" asp-controller="Main" asp-action="XmProjectList" class="btn btn-dark" style="width:75px; margin-top:30px" title="Back">
                            <span class="text-white">Back</span>
                        </a>

                    }
                    <button type="submit" class="btn btn-info" title="Save" style="width:100px; margin-top:30px"><span class="text-white">Save</span></button>
                </div>
            </div>
            <input type="hidden" asp-for="OldTaskDelegationId" />
            <input type="hidden" asp-for="TaskItemId" />
            <input type="hidden" asp-for="TaskOwnerId" />
            <input type="hidden" asp-for="SourcePage" />
            <input type="hidden" asp-for="DelegatedByEmployeeId" />
            <input type="hidden" asp-for="DelegatedToEmployeeId" />
            <input type="hidden" asp-for="DelegatedTime" />
            <input type="hidden" asp-for="LinkProjectId" />
            <input type="hidden" asp-for="LinkProjectCode" />
        </form>
    </div>
</div>
@section Scripts{
    <script src="~/js/js_erm/erm_employees.js"></script>
}
