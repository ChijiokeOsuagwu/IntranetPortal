@model IntranetPortal.Areas.XMD.Models.ProjectTaskListViewModel
<div class="container">
    <h5 class="mb-1">Project: @Model.ProjectTitle</h5>
    <hr />
    <div class="row">
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNavDropdown">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a asp-area="XMD" asp-controller="Main" asp-action="XmProjectList" title="Go Back" class="btn btn-sm btn-outline-light text-dark">
                                <i class="bi bi-backspace fw-bolder" style="font-size: 1.0rem;"></i> <span class="fw-bold ml-1" style="font-size: 0.9rem;">Back</span>
                            </a>
                        </li>
                        @if (Model.ProjectID > 0)
                        {
                            <li class="nav-item">
                                <a asp-area="XMD" asp-controller="Main" asp-action="XmDelegateTask" asp-route-id="0" asp-route-pd="@Model.ProjectID" asp-route-pn="@Model.ProjectNo" asp-route-src="pjt" title="Add New Task" class="btn btn-sm btn-light text-dark">
                                    <i class="bi bi-plus-lg fw-bolder" style="font-size: 1.0rem; font-weight:900"></i><span class="fw-bold ml-1" style="font-size: 0.9rem;">Create New Task</span>
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </div>
    <div class="row">
        @if (Model == null || Model.TaskItems == null || Model.TaskItems.Count < 1)
        {
            <div class="alert alert-secondary alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold text-dark">No record was found.</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else
        {
            int row_number = 0;
            <div class="table-responsive">
                @foreach (var task in Model.TaskItems)
                {
                    row_number++;
                    <div class="card">
                        @if (task.ApprovalStatus == ApprovalStatus.Declined)
                        {
                            <div class="card-header" style="background-color:#D11604">
                                <div class="row">
                                    <div class="col-md-5" title="Assigned To">
                                        @if (string.IsNullOrWhiteSpace(task.DelegatedToEmployeeName))
                                        {
                                            <span class="fw-bold text-white" title="Assigned To"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> Self </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Assigned To"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> @task.DelegatedToEmployeeName</span>
                                        }
                                    </div>
                                    <div class="col-md-4" title="Time Assigned">
                                        @if (task.AssignedTime == null)
                                        {
                                            <span class="fw-bold text-white" title="Time Assigned"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> @task.CreatedTime.Value.ToString("dd-MMM-yyyy ")   @task.CreatedTime.Value.ToShortTimeString()</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Time Assigned"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> @task.AssignedTime.Value.ToString("dd-MMM-yyyy ")   @task.AssignedTime.Value.ToShortTimeString()</span>
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        @if (task.ProgressStatus == WorkItemProgressStatus.Completed)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-check-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i> Completed
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.InProgress)
                                        {
                                            <div class="fw-bold" style="font-size:1.0rem; color:white">
                                                <i class="bi bi-clock-history" style="color:white; font-size:1.0rem; font-weight:bold"></i>  In Progress
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.OnHold)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-slash-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i>  On Hold
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.NotStarted)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-dash-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i> Not Started
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fw-bold" style="font-size:1.0rem">
                                                <i class="bi bi-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i>  [N/A]
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else if (task.ApprovalStatus == ApprovalStatus.Approved)
                        {
                            <div class="card-header bg-info">
                                <div class="row">
                                    <div class="col-md-5" title="Assigned To">
                                        @if (string.IsNullOrWhiteSpace(task.DelegatedToEmployeeName))
                                        {
                                            <span class="fw-bold text-white" title="Assigned To"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> Self </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Assigned To"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> @task.DelegatedToEmployeeName</span>
                                        }
                                    </div>
                                    <div class="col-md-4" title="Date Assigned">
                                        @if (task.AssignedTime == null)
                                        {
                                            <span class="fw-bold text-white" title="Time Assigned"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> @task.CreatedTime.Value.ToString("dd-MMM-yyyy ")   @task.CreatedTime.Value.ToShortTimeString()</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Time Assigned"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> @task.AssignedTime.Value.ToString("dd-MMM-yyyy ")   @task.AssignedTime.Value.ToShortTimeString()</span>
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        @if (task.ProgressStatus == WorkItemProgressStatus.Completed)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-check-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i> Completed
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.InProgress)
                                        {
                                            <div class="fw-bold" style="font-size:1.0rem; color:white">
                                                <i class="bi bi-clock-history" style="color:white; font-size:1.0rem; font-weight:bold"></i>  In Progress
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.OnHold)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-slash-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i>  On Hold
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.NotStarted)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-dash-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i> Not Started
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fw-bold" style="font-size:1.0rem">
                                                <i class="bi bi-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i>  [N/A]
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="card-header bg-dark">
                                <div class="row">
                                    <div class="col-md-5" title="Assigned To">
                                        @if (string.IsNullOrWhiteSpace(task.DelegatedToEmployeeName) || task.DelegatedToEmployeeName == task.TaskOwnerName)
                                        {
                                            <span class="fw-bold text-white" title="Assigned To"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> Self </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Assigned To"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> @task.DelegatedToEmployeeName</span>
                                        }
                                    </div>
                                    <div class="col-md-4" title="Date Assigned">
                                        @if (task.AssignedTime == null)
                                        {
                                            <span class="fw-bold text-white" title="Date Assigned"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> @task.CreatedTime.Value.ToString("dd-MMM-yyyy ")   @task.CreatedTime.Value.ToShortTimeString()</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Date Assigned"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> @task.AssignedTime.Value.ToString("dd-MMM-yyyy ")   @task.AssignedTime.Value.ToShortTimeString()</span>
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        @if (task.ProgressStatus == WorkItemProgressStatus.Completed)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-check-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i> Completed
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.InProgress)
                                        {
                                            <div class="fw-bold" style="font-size:1.0rem; color:white">
                                                <i class="bi bi-clock-history" style="color:white; font-size:1.0rem; font-weight:bold"></i>  In Progress
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.OnHold)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-slash-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i>  On Hold
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.NotStarted)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-dash-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i> Not Started
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fw-bold" style="font-size:1.0rem">
                                                <i class="bi bi-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i>  [N/A]
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="card-body table-secondary">
                            <div class="row">
                                <div class="col-md-2 mb-3">
                                    <label class="form-label text-dark">Task No.</label>
                                    <input asp-for="@task.Number" class="form-control fw-bold" readonly="readonly">
                                </div>
                                <div class="col-md-2 mb-3">
                                    <label class="form-label text-dark">Expected Start Date</label>
                                    @if (task.ExpectedStartTime != null)
                                    {
                                        <div class="form-control fw-bold">@task.ExpectedStartTime.Value.ToString("dd-MMM-yyyy")</div>
                                    }
                                    else
                                    {
                                        <div class="form-control fw-bold">[Not Specified]</div>
                                    }
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label text-dark">Actual Start Date</label>
                                    @if (task.ActualStartTime != null)
                                    {
                                        <div class="form-control fw-bold">@task.ActualStartTime.Value.ToString("dd-MMM-yyyy")</div>
                                    }
                                    else
                                    {
                                        <div class="form-control fw-bold">[Not Specified]</div>
                                    }
                                </div>
                                <div class="col-md-2 mb-3">
                                    <label class="form-label text-dark">Expected Completion Date</label>
                                    @if (task.ExpectedDueTime != null)
                                    {
                                        <div class="form-control fw-bold">@task.ExpectedDueTime.Value.ToString("dd-MMM-yyyy")</div>
                                    }
                                    else
                                    {
                                        <div class="form-control fw-bold">[Not Specified]</div>
                                    }
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label text-dark">Actual Completion Date</label>
                                    @if (task.ActualDueTime != null)
                                    {
                                        <div class="form-control fw-bold">@task.ActualDueTime.Value.ToString("dd-MMM-yyyy")</div>
                                    }
                                    else
                                    {
                                        <div class="form-control fw-bold">[Not Specified]</div>
                                    }
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label text-dark">Description</label>
                                    <textarea asp-for="@task.Description" class="form-control fw-bold" readonly="readonly">@task.Description</textarea>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(task.MoreInformation))
                            {
                                <div class="row">
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label text-dark">Resolution</label>
                                        <textarea asp-for="@task.MoreInformation" class="form-control fw-bold" readonly="readonly">@task.MoreInformation</textarea>
                                    </div>
                                </div>
                            }
                        <div class="row">
                            <div class="col-md-12 mt-1">
                                <a asp-area="XMD" asp-controller="Main" asp-action="XmReassignTask" asp-route-id="@task.TaskDelegationId" asp-route-td="@task.Id" asp-route-pd="@Model.ProjectID" asp-route-src="pjt" class="table-secondary fw-bold mr-3" style="border:0px" title="Reassign Task">
                                    <span class="fw-bold" style="font-size:0.8rem; color:black"><i class="bi bi-person-check-fill" style="font-size:1.0rem;"></i> Re-Assign Task</span>
                                </a>
                                <!-- Default dropstart button -->
                                <div class="btn-group dropstart" title="Options">
                                    <button type="button" data-bs-toggle="dropdown" aria-expanded="false" class="table-secondary" style="border:0px" title="Options">
                                        <span class="fw-bold" style="font-size:0.8rem;"><i class="bi bi-tools"></i> Options</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                        @if (task.StageId < 4)
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-area="XMD" asp-controller="Main" asp-action="XmDelegateTask" asp-route-id="@task.TaskDelegationId" asp-route-pn="@task.LinkProjectNumber" asp-route-od="@task.TaskOwnerId" asp-route-src="pjt">
                                                    <i class="bi bi-pencil-fill"></i> <span>Edit</span>
                                                </a>
                                            </li>
                                        }
                                        @if (task.IsClosed)
                                        {
                                            <li>
                                                <button class="dropdown-item" onclick="ReopenTaskItem('@task.Id')">
                                                    <i class="bi bi-bootstrap-reboot"></i> <span>Re-Open</span>
                                                </button>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <button class="dropdown-item" onclick="closeTaskItem('@task.Id')">
                                                    <i class="bi bi-x-circle"></i> <span>Close</span>
                                                </button>
                                            </li>
                                        }
                                        <li>
                                            <button class="dropdown-item" id="btn_delete_@task.Id" onclick="deleteTaskItem('@task.Id')">
                                                <i class="bi bi-trash"></i> <span> Delete</span>
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-area="WSP" asp-controller="Workspace" asp-action="TaskDetails" asp-route-id="@task.Id">
                                                <i class="bi bi-info-circle"></i>  <span>Detail</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="XMD" asp-controller="Main" asp-action="Notes" asp-route-td="@task.Id" asp-route-sp="pjt" asp-route-pd="@Model.ProjectID">
                                                <i class="bi bi-stickies"></i> <span>Notes</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="XMD" asp-controller="Main" asp-action="history" asp-route-td="@task.Id">
                                                <i class="bi bi-file-text"></i> <span>History</span>
                                            </a>
                                        </li>
                                        @*<li>
                    <a class="dropdown-item" asp-area="WSP" asp-controller="Workspace" asp-action="ScheduleHistory" asp-route-id="@task.Id" asp-route-fd="@task.WorkFolderId">
                        <i class="bi bi-file-text"></i> <span>Schedule History</span>
                    </a>
                </li>*@
                                    </ul>
                                </div>
                            </div>
                        </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
@section Scripts{
    <script src="~/js/wsp.js"></script>
}
