
@model IntranetPortal.Areas.LVM.Models.LeavePlanViewModel
<h3 class="mb-1">My Leave Records</h3>
<hr />
<div class="card mt-1" style="max-width:1000px">
    <div class="card-header bg-success">
        <h4 class="text-white">New Leave Plan</h4>
    </div>
    <div class="card-body bg-secondary">
        @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!String.IsNullOrEmpty(Model.ViewModelSuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i>
                <span class="fw-bold">@Model.ViewModelSuccessMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!String.IsNullOrEmpty(Model.ViewModelWarningMessage))
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle"></i>
                <span class="fw-bold">@Model.ViewModelWarningMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <form asp-area="LVM" asp-controller="Leave" asp-action="NewLeavePlan" method="post" autocomplete="off">
            <div class="row">
                <div class="col-md-5 mb-3">
                    <label asp-for="LeaveEmployeeName" class="form-label text-white fw-bold"></label>
                    <input asp-for="LeaveEmployeeName" class="form-control fw-bold" readonly>
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="LeaveYear" class="form-label text-white fw-bold"></label>
                    <input asp-for="LeaveYear" class="form-control fw-bold" min="2020" max="2060" autofocus>
                    <div><span asp-validation-for="LeaveYear" class="text-danger"></span></div>
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="LeaveTypeCode" class="form-label text-white fw-bold"></label>
                    <select asp-for="LeaveTypeCode" class="form-control fw-bold" asp-items="@ViewBag.LeaveTypeCodeList" autofocus>
                        <option value="">Select</option>
                    </select>
                    <div><span asp-validation-for="LeaveTypeCode" class="text-danger"></span></div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label text-white fw-bold">Current Leave Balance</label>
                    <input asp-for="CurrentLeaveBalanceDescription" class="form-control fw-bold" readonly>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="LeavePlanStartDate" class="form-label text-white fw-bold"></label>
                    <input asp-for="LeavePlanStartDate" class="form-control fw-bold" type="date">
                    <div><span asp-validation-for="LeavePlanStartDate" class="text-danger"></span></div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label text-white fw-bold">Leave Duration</label>
                    <div class="input-group">
                        <input asp-for="LeavePlanDuration" class="form-control fw-bold" min="1" max="365" style="max-width:80px">
                        <select asp-for="LeavePlanDurationTypeId" class="form-control fw-bold">
                            <option value="">Select</option>
                            <option value="0">Working Day(s)</option>
                            <option value="1">Day(s)</option>
                            <option value="2">Week(s)</option>
                            <option value="3">Month(s)</option>
                            <option value="4">Year(s)</option>
                        </select>
                    </div>
                    <div><span asp-validation-for="LeavePlanDuration" class="text-danger"></span></div>
                    <div><span asp-validation-for="LeavePlanDurationTypeId" class="text-danger"></span></div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label text-white fw-bold">Leave Ends On:</label>
                    <input asp-for="LeavePlanEndDate" id="LeavePlanEndDate" class="form-control fw-bold" type="date" readonly onclick="getLastLeaveDate()">
                    <div><span id="leavePlanEndDateErrorSpan" asp-validation-for="LeavePlanEndDate" class="text-danger"></span></div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label text-white fw-bold">Resumes Work On:</label>
                    <input asp-for="LeavePlanResumptionDate" id="LeavePlanResumptionDate" class="form-control fw-bold" type="date" readonly onclick="getExpectedResumptionDate()">
                    <div><span id="LeavePlanResumptionDateErrorSpan" asp-validation-for="LeavePlanResumptionDate" class="text-danger"></span></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="LeaveReason" class="form-label text-white fw-bold"></label>
                    <textarea asp-for="LeaveReason" class="form-control fw-bold">@Model.LeaveReason</textarea>
                    <div><span asp-validation-for="LeaveReason" class="text-danger"></span></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 text-end">
                    <a asp-area="LVM" asp-controller="Leave" asp-action="MyLeaveRecords" class="btn btn-dark" style="width:100px" title="Exit">
                        <span class="text-white">Exit</span>
                    </a>
                    <a asp-area="LVM" asp-controller="Leave" asp-action="NewLeavePlan" class="btn btn-warning" style="width:100px" title="Clear">
                        <span class="text-white">Clear</span>
                    </a>
                    @if (!Model.OperationIsSuccessful)
                    {
                        <button type="submit" class="btn btn-success" title="Save" style="width:200px"><span class="text-white">Save</span></button>
                    }
                </div>
            </div>
            <input type="hidden" asp-for="LeavePlanId">
            <input type="hidden" asp-for="LeaveEmployeeId" />
            <input type="hidden" asp-for="LeaveEmployeeName" />
            <input type="hidden" asp-for="CurrentLeaveBalance" />
        </form>
    </div>
</div>
@section Scripts{
    <script src="~/js/lvs.js"></script>
}
