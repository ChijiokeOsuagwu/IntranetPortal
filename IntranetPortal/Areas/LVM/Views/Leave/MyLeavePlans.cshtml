@model IntranetPortal.Areas.LVM.Models.MyLeavePlansListViewModel
<div class="container">
    <h3 class="mb-1">My Leave Plans</h3>
    <hr />
    <div class="mb-2">
        <form asp-area="LVM" asp-controller="Home" asp-action="MyLeavePlans" method="get">
            <div class="row">
                <div class="col-md-4">
                    <a asp-area="LMS" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-dark" style="width:100px;" title="Exit">
                        <span class="text-white">Back</span>
                    </a>
                </div>
                <div class="col-md-6">
                    <span class="text-dark fw-bold">Select Year: </span>
                    <input asp-for="yr" class="border-0" style="width:100px" min="2020" max="2060">
                    <input type="submit" value="Search" class="btn btn-sm btn-dark mr-3 text-white" style="width:100px; margin-right:20px" />
                </div>
                <div class="col-md-2">
                    <a asp-area="LVM" asp-controller="Leave" asp-action="NewLeavePlan" asp-route-id="0" class="btn btn-sm btn-success" style="width:150px" title="Add New Leave Plan">
                        <span class="text-white">New Plan</span>
                    </a>
                </div>
            </div>
        </form>

        @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>
    <div class="row">
        @if (Model == null || Model.LeavePlanList == null || Model.LeavePlanList.Count < 1)
        {
            <div class="alert alert-info fade show" role="alert">
                <i class="bi bi-info-circle"></i>
                <span class="fw-bold">No record was found.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                @foreach (var plan in Model.LeavePlanList)
                {
                    <div class="card" style="width:80pc">
                        <div class="card-header bg-info">
                            <div class="row">
                                <div class="col-md-2" title="Leave Year">
                                    @if (plan.LeaveYear < 1)
                                    {
                                        <span class="fw-bold text-white" title="Leave Year"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i> [Unspecified]</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-white" title="Leave Year"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i> @plan.LeaveYear.ToString()</span>
                                    }
                                </div>
                                <div class="col-md-5" title="Leave Type">
                                    @if (string.IsNullOrWhiteSpace(plan.LeaveTypeName))
                                    {
                                        <span class="fw-bold text-white" title="Leave Type"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> [Not Specified] </span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-white" title="Leave Type"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> @plan.LeaveTypeName</span>
                                    }
                                </div>
                                <div class="col-md-3" title="Leave Duration">
                                    @if (plan.IsApproved)
                                    {
                                        <span class="fw-bold text-white" title="Leave Duration"><i class="bi bi-clock" style="font-size:1.2rem; font-weight:bold"></i> @plan.ApprovedDurationDescription</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-white" title="Leave Duration"><i class="bi bi-clock" style="font-size:1.2rem; font-weight:bold"></i> @plan.ProposedDurationDescription</span>
                                    }
                                </div>

                                <div class="col-md-3" title="Status">
                                    <span class="fw-bold" style="color:white" title="Leave Status"><i class="bi bi-speedometer2" style="font-size:1.0rem; font-weight:bold"></i> @plan.LeavePlanStatus</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-body bg-light">
                            <div class="row">
                                <div class="col-md-4" title="Proposed Start Date">
                                    @if (plan.ProposedStartDate == null)
                                    {
                                        <span class="fw-bold text-white" title="Proposed Start Date"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i>Proposed Start Date: [Unspecified]</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-white" title="Proposed Start Date"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i>Proposed Start Date: @plan.ProposedStartDate.Value.ToString("f")</span>
                                    }
                                </div>
                                <div class="col-md-4" title="Proposed Last Date">
                                    @if (plan.ProposedEndDate == null)
                                    {
                                        <span class="fw-bold text-white" title="Proposed Last Date"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i>Proposed Start Date: [Unspecified]</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-white" title="Proposed End Date"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i>Proposed End Date: @plan.ProposedEndDate.Value.ToString("f")</span>
                                    }
                                </div>

                                <div class="col-md-4" title="Proposed Duration">
                                    @if (string.IsNullOrWhiteSpace(plan.ProposedDurationDescription))
                                    {
                                        <span class="fw-bold text-white" title="Proposed Duration"><i class="bi bi-clock" style="font-size:1.2rem; font-weight:bold"></i>Proposed Duration: [N/A]</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-white" title="Proposed Duration"><i class="bi bi-clock" style="font-size:1.2rem; font-weight:bold"></i>Proposed Duration: @plan.ProposedDurationDescription</span>
                                    }
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4" title="Approved Start Date">
                                    @if (plan.ApprovedStartDate == null)
                                    {
                                        <span class="fw-bold text-white" title="Approved Start Date"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i>Approved Start Date: [Unspecified]</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-white" title="Approved Start Date"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i>Approved Start Date: @plan.ApprovedStartDate.Value.ToString("f")</span>
                                    }
                                </div>
                                <div class="col-md-4" title="Approved Last Date">
                                    @if (plan.ApprovedEndDate == null)
                                    {
                                        <span class="fw-bold text-white" title="Approved Last Date"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i>Approved Start Date: [Unspecified]</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-white" title="Approved End Date"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i>Approved End Date: @plan.ApprovedEndDate.Value.ToString("f")</span>
                                    }
                                </div>

                                <div class="col-md-4" title="Approved Duration">
                                    @if (string.IsNullOrWhiteSpace(plan.ApprovedDurationDescription))
                                    {
                                        <span class="fw-bold text-white" title="Approved Duration"><i class="bi bi-clock" style="font-size:1.2rem; font-weight:bold"></i>Approved Duration: [N/A]</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-white" title="Approved Duration"><i class="bi bi-clock" style="font-size:1.2rem; font-weight:bold"></i>Approved Duration: @plan.ApprovedDurationDescription</span>
                                    }
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12 text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-light btn-sm" type="button" id="dropdownMenuButton2" data-bs-toggle="dropdown" aria-expanded="false">
                                            <span class="fw-bold text-dark"><i class="bi bi-three-dots"></i></span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                            <li>
                                                <a asp-area="LVM" asp-controller="Leave" asp-action="LeavePlanDetails" asp-route-id="@plan.LeavePlanId" title="View Details" class="dropdown-item">
                                                    <span class="text-white"><i class="bi bi-info-circle"></i> View</span>
                                                </a>
                                            </li>
                                            @if (plan.LeavePlanStatus == "Draft" || plan.LeavePlanStatus == "Cancelled")
                                            {
                                                <li>
                                                    <a asp-area="LVM" asp-controller="Leave" asp-action="EditLeavePlan" asp-route-id="@plan.LeavePlanId" title="Edit" class="dropdown-item">
                                                        <span class="text-white"><i class="bi bi-pencil-square"></i> Edit</span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a asp-area="LVM" asp-controller="Leave" asp-action="DeleteLeavePlan" asp-route-id="@plan.LeavePlanId" title="Delete" class="dropdown-item">
                                                        <span class="text-white"><i class="bi bi-trash"></i> Delete</span>
                                                    </a>
                                                </li>
                                            }
                                            <li>
                                                <a asp-area="LVM" asp-controller="Leave" asp-action="SubmitLeavePlan" asp-route-id="@plan.LeavePlanId" title="Submit" class="dropdown-item">
                                                    <span class="text-white"><i class="bi bi-box-arrow-in-right"></i> Submit</span>
                                                </a>
                                            </li>
                                            @if (plan.LeavePlanStatus == "Approved" || plan.LeavePlanStatus == "Confirmed")
                                            {
                                                <li>
                                                    <a asp-area="LVM" asp-controller="Leave" asp-action="NewLeaveRequest" asp-route-id="@plan.LeavePlanId" title="Create Leave Request" class="dropdown-item">
                                                        <span class="text-white"><i class="bi bi-envelope"></i> Request</span>
                                                    </a>
                                                </li>
                                            }
                                            <li>
                                                <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveApprovals" asp-route-id="@plan.LeavePlanId" asp-route-sp="mlp" asp-route-yr="@plan.LeaveYear" title="View Approvals" class="dropdown-item">
                                                    <span class="text-white"><i class="bi bi-calendar-check"></i> View Approvals</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveNotes" asp-route-id="@plan.LeavePlanId" asp-route-sp="mlp" asp-route-yr="@plan.LeaveYear" title="View Notes" class="dropdown-item">
                                                    <span class="text-white"><i class="bi bi-journals"></i> View Notes</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveActivities" asp-route-id="@plan.LeavePlanId" title="Activity Log" class="dropdown-item">
                                                    <span class="text-white"><i class="bi bi-file-earmark-text"></i> View Log</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>
