@model IntranetPortal.Areas.LVM.Models.LeavePendingApprovalListViewModel
<div class="container">
    <h4 class="mb-1">Leaves Submitted to Me</h4>
    <hr />
    <div class="row">
        <div class="col-md-4 mb-2">
            <a asp-area="LVM" asp-controller="Leave" asp-action="Index" class="btn mr-3" style="width:100px; border-radius:4px; background-color:#2e4053" title="Exit">
                <span class="text-white">Back</span>
            </a>
        </div>
        <div class="col-md-8 mb-2 text-center">
            <form asp-area="LVM" asp-controller="Leave" asp-action="LeavePendingApproval" method="get">
                <input asp-for="yr" class="border-0" style="width:100px" min="2020" max="2060" />
                <input type="submit" value="Search" class="btn text-white ml-3" style="width:100px; border-radius:4px; background-color:#2e4053" />
            </form>
        </div>
    </div>

    @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-x-circle"></i>
            <span class="fw-bold">@Model.ViewModelErrorMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="row">
        @if (Model == null || Model.LeaveSubmissionList == null || Model.LeaveSubmissionList.Count < 1)
        {
            <div class="alert alert-info fade show" role="alert">
                <i class="bi bi-info-circle"></i>
                <span class="fw-bold">No record was found.</span>
            </div>
        }
        else
        {
            <div class="table-responsive" style="min-height:450px">
                <table class="table table-sm table-hover">
                    <thead style="background-color:#2e4053">
                        <tr>
                            <th><span class="text-white fw-bolder">Document</span></th>
                            <th><span class="text-white fw-bolder">From</span></th>
                            <th>
                                <span class="text-white fw-bolder">Purpose</span>
                            </th>
                            <th>
                                <span class="text-white fw-bolder">Date Submitted</span>
                            </th>
                            <th>
                                <span class="text-white fw-bolder">Status</span>
                            </th>
                            <th>

                            </th>
                        </tr>
                    </thead>
                    <tbody style="background-color:#d1f2eb">
                        @foreach (var item in Model.LeaveSubmissionList)
                        {
                            @if (item.LeavePlanId > 0)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bolder"> Leave Plan </span>
                                    </td>
                                    <td>
                                        <span class="fw-bolder">@item.FromEmployeeName</span>
                                    </td>
                                    <td>
                                        <span class="fw-bolder">@item.Purpose</span>
                                    </td>
                                    <td>
                                        <span class="fw-bolder">@item.TimeSubmitted.Value.ToLongDateString() @item.TimeSubmitted.Value.ToLongTimeString()</span>
                                    </td>
                                    @if (item.IsActioned)
                                    {
                                        <td class="text-center">
                                            <span class="badge rounded-pill bg-success fw-bold" style="width:100px; font-size:0.9rem;">Actioned</span>
                                        </td>
                                        <td class="text-end">
                                            <!-- Default dropstart button -->
                                            <div class="btn-group dropstart">
                                                <button type="button" data-bs-toggle="dropdown" aria-expanded="false" class="btn btn-sm" style="border-radius:10px; width:100px; background-color:#2e4053">
                                                    <span class="text-white"><i class="bi bi-tools"></i> Options</span>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                                    <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="ViewLeavePlan" asp-route-id="@item.LeavePlanId">
                                                            <i class="bi bi-info-circle"></i>  <span>View Details</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="LeaveNotes" asp-route-pd="@item.LeavePlanId" asp-route-sp="lpa">
                                                            <i class="bi bi-stickies"></i> <span>Notes</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="LeaveActivities" asp-route-pd="@item.LeavePlanId">
                                                            <i class="bi bi-file-text"></i> <span>History</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item" onclick="deleteLeaveSubmission('@item.LeaveSubmissionId')">
                                                            <i class="bi bi-trash"></i> <span> Delete</span>
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <span class="badge rounded-pill bg-warning fw-bold" style="font-size:0.9rem; color:black; width:100px">Pending</span>
                                        </td>
                                        <td class="text-end">
                                            <!-- Default dropstart button -->
                                            <div class="btn-group dropstart">
                                                <button type="button" data-bs-toggle="dropdown" aria-expanded="false" class="btn btn-sm" style="border-radius:10px; width:100px; background-color:#2e4053">
                                                    <span class="text-white"><i class="bi bi-tools"></i> Options</span>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                                    <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="LeavePlanApproval" asp-route-id="@item.LeavePlanId" asp-route-sd="@item.LeaveSubmissionId" asp-route-sp="lpa">
                                                            <i class="bi bi-arrow-right-circle"></i>  <span> Proceed </span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="ViewLeavePlan" asp-route-id="@item.LeavePlanId">
                                                            <i class="bi bi-info-circle"></i>  <span>View Details</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="LeaveNotes" asp-route-pd="@item.LeavePlanId" asp-route-sp="lpa">
                                                            <i class="bi bi-stickies"></i> <span>Notes</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="LeaveActivities" asp-route-pd="@item.LeavePlanId">
                                                            <i class="bi bi-file-text"></i> <span>History</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item" onclick="deleteLeaveSubmission('@item.LeaveSubmissionId')">
                                                            <i class="bi bi-trash"></i> <span> Delete</span>
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                            </td>
                                                                         
                                    }
                                       </tr>
                            }
                            else if (item.LeaveRequestId > 0)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bolder"> @item.DocumentType </span>
                                    </td>
                                    <td>
                                        <span class="fw-bolder">@item.FromEmployeeName</span>
                                    </td>
                                    <td>
                                        <span class="fw-bolder">@item.Purpose</span>
                                    </td>
                                    <td>
                                        <span class="fw-bolder">@item.TimeSubmitted.Value.ToLongDateString() @item.TimeSubmitted.Value.ToLongTimeString()</span>
                                    </td>
                                    @if (item.IsActioned)
                                    {
                                        <td class="text-center">
                                            <span class="badge rounded-pill bg-success fw-bold" style="width:100px; font-size:0.9rem;">Actioned</span>
                                        </td>
                                        <td class="text-end">
                                            <!-- Default dropstart button -->
                                            <div class="btn-group dropstart">
                                                <button type="button" data-bs-toggle="dropdown" aria-expanded="false" class="btn btn-sm" style="border-radius:10px; width:100px; background-color:#2e4053">
                                                    <span class="text-white"><i class="bi bi-tools"></i> Options</span>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                                    <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="ViewLeaveRequest" asp-route-id="@item.LeaveRequestId">
                                                            <i class="bi bi-info-circle"></i>  <span>View Details</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="LeaveNotes" asp-route-rd="@item.LeaveRequestId" asp-route-sp="lpa">
                                                            <i class="bi bi-stickies"></i> <span>Notes</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="LeaveActivities" asp-route-rd="@item.LeaveRequestId">
                                                            <i class="bi bi-file-text"></i> <span>History</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item" onclick="deleteLeaveSubmission('@item.LeaveSubmissionId')">
                                                            <i class="bi bi-trash"></i> <span> Delete</span>
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <span class="badge rounded-pill bg-warning fw-bold" style="font-size:0.9rem; color:black; width:100px">Pending</span>
                                        </td>
                                        <td class="text-end">
                                            <!-- Default dropstart button -->
                                            <div class="btn-group dropstart">
                                                <button type="button" data-bs-toggle="dropdown" aria-expanded="false" class="btn btn-sm" style="border-radius:10px; width:100px; background-color:#2e4053">
                                                    <span class="text-white"><i class="bi bi-tools"></i> Options</span>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                                    @if(item.Purpose == "Approval")
                                                    {
                                                        @if(item.ToEmployeeRole == "HR Department")
                                                        {
                                                            @if(Model.UserIsSeniorHr)
                                                            {
                                                                                                                                                                                <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="LeaveRequestApproval" asp-route-id="@item.LeaveRequestId" asp-route-sd="@item.LeaveSubmissionId" asp-route-src="lpa">
                                                            <i class="bi bi-arrow-right-circle"></i>  <span> Proceed </span>
                                                        </a>
                                                    </li>
                                                            }
                                                        }
                                                        else
                                                        {
                                                                                                                <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="LeaveRequestApproval" asp-route-id="@item.LeaveRequestId" asp-route-sd="@item.LeaveSubmissionId" asp-route-src="lpa">
                                                            <i class="bi bi-arrow-right-circle"></i>  <span> Proceed </span>
                                                        </a>
                                                    </li>

                                                        }
                                                    }
                                                    else if(item.Purpose == "Confirm Resumption")
                                                    {
                                                    <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="ConfirmResumption" asp-route-rd="@item.LeaveRequestId" asp-route-sd="@item.LeaveSubmissionId">
                                                            <i class="bi bi-arrow-right-circle"></i>  <span> Proceed </span>
                                                        </a>
                                                    </li>

                                                    }
                                                    <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="ViewLeaveRequest" asp-route-id="@item.LeaveRequestId">
                                                            <i class="bi bi-info-circle"></i>  <span>View Details</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="LeaveNotes" asp-route-rd="@item.LeaveRequestId" asp-route-sp="lpa">
                                                            <i class="bi bi-stickies"></i> <span>Notes</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="LVM" asp-controller="Leave" asp-action="LeaveActivities" asp-route-rd="@item.LeaveRequestId">
                                                            <i class="bi bi-file-text"></i> <span>History</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item" onclick="deleteLeaveSubmission('@item.LeaveSubmissionId')">
                                                            <i class="bi bi-trash"></i> <span> Delete</span>
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
@section Scripts{
    <script src="~/js/lvs.js"></script>
}