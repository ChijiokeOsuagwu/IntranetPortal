@{
    ViewData["Title"] = "Leave Management System";
}
<link href="~/lib/matrix/dist/css/style.min.css" rel="stylesheet" />
<div class="my-2">
    <!-- ============================================================== -->
    <!-- Sales Cards  -->
    <!-- ============================================================== -->
    <h4 class="fw-bold">Leave Management System</h4>
    <hr />
    <div class="row">
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="" asp-controller="Home" asp-action="Apps">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-arrow-left-square"></i></h1>
                        <h6 class="text-dark">Go Back</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-controller="Leave" asp-action="MyLeaveRecords">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-calendar-range"></i></h1>
                        <h6 class="text-dark">My Leave Records</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-controller="Leave" asp-action="LeavePendingApproval">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-calendar-week"></i></h1>
                        <h6 class="text-dark">Leave Pending My Action</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-controller="Leave" asp-action="MyTeamsLeavePlans">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-calendar-week"></i></h1>
                        <h6 class="text-dark">My Team's Leave Plans</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-controller="Leave" asp-action="MyTeamsLeaveRequests">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-calendar2-week"></i></h1>
                        <h6 class="text-dark">My Team's Leave Requests</h6>
                    </div>
                </div>
            </a>
        </div>
        @if (User.IsInRole("XYALLACCZ") || User.IsInRole("GBSHRDEDT") || User.IsInRole("GBSHRDAPV"))
        {
            <!-- Column -->
            <div class="col-md-6 col-lg-2 col-xlg-3">
                <a asp-area="LVM" asp-controller="Leave" asp-action="Dashboard">
                    <div class="card card-hover">
                        <div class="box bg-light text-center">
                            <h1 class="font-light text-dark"><i class="bi bi-columns"></i></h1>
                            <h6 class="text-dark">HR Dashboard</h6>
                        </div>
                    </div>
                </a>
            </div>
        }
        <!-- Column -->
        @*<div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="PMS" asp-controller="Home" asp-action="AppraisalEnquiry">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-search"></i></h1>
                        <h6 class="text-dark">Enquiry</h6>
                    </div>
                </div>
            </a>
        </div>*@
        <!-- Column -->
        @*<div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="PMS" asp-controller="Home" asp-action="Reports">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-journal-bookmark"></i></h1>
                        <h6 class="text-dark">Reports</h6>
                    </div>
                </div>
            </a>
        </div>*@
        <!-- Column -->
        @*<div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="PMS" asp-Controller="Home" asp-action="CheckEntries">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-list-check"></i></h1>
                        <h6 class="text-dark">Check/Verify Entries</h6>
                    </div>
                </div>
            </a>
        </div>*@
        <!-- Column -->
        @*<div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="PMS" asp-Controller="Home" asp-action="EmployeeSearch">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-arrow-left-right"></i></h1>
                        <h6 class="text-dark">Change Principal Appraiser</h6>
                    </div>
                </div>
            </a>
        </div>*@
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-Controller="Settings" asp-action="Index">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-sliders"></i></h1>
                        <h6 class="text-dark">Settings</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
    </div>
</div>
@section Scripts{

