@{
    ViewData["Title"] = "Leave Management System";
}
<link href="~/lib/matrix/dist/css/style.min.css" rel="stylesheet" />
<div class="my-2">
    <!-- ============================================================== -->
    <!-- Sales Cards  -->
    <!-- ============================================================== -->
    <h4 class="fw-bold">Leave Management System | HR Dashboard</h4>
    <hr />
    <div class="row">
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-controller="Leave" asp-action="Index">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-arrow-left-square"></i></h1>
                        <h6 class="text-dark">Go Back</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-controller="Leave" asp-action="LeavePlans">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-calendar-range"></i></h1>
                        <h6 class="text-dark">Leave Plans</h6>
                    </div>
                </div>
            </a>
        </div>
                <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveRecords">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-bag-check"></i></h1>
                        <h6 class="text-dark">Leave Records</h6>
                    </div>
                </div>
            </a>
        </div>
                <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveSubmittedToHr">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-mailbox"></i></h1>
                        <h6 class="text-dark">Leave Pending Approval </h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-controller="Leave" asp-action="ApprovedLeaveRequests">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-bag-check"></i></h1>
                        <h6 class="text-dark">Leave Pending Confirmation</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
                <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveRequestsDueResumption">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-bag-check"></i></h1>
                        <h6 class="text-dark">Leave Due Resumption</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-controller="Leave" asp-action="LeavePlanReport">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-file-earmark-spreadsheet"></i></h1>
                        <h6 class="text-dark">Leave Plan Report</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
         <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveRequestReport">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-file-earmark-spreadsheet"></i></h1>
                        <h6 class="text-dark">Employee Leave Report</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
          <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-controller="Leave" asp-action="LeavePlanComplianceReport">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-file-earmark-spreadsheet"></i></h1>
                        <h6 class="text-dark">Leave Plan Compliance Report</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveRequestComplianceReport">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-file-earmark-spreadsheet"></i></h1>
                        <h6 class="text-dark">Leave Compliance Report</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="LVM" asp-controller="Leave" asp-action="AnnualLeaveSummaryReport">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-file-earmark-spreadsheet"></i></h1>
                        <h6 class="text-dark">Annual Leave Summary Report</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
    </div>
</div>
@section Scripts{

}
