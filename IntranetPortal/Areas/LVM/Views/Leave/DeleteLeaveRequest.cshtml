
@model IntranetPortal.Areas.LVM.Models.LeaveRequestViewModel
<h3 class="mb-1">My Leave Records</h3>
<hr />
<div class="card mt-1" style="max-width:1000px">
    <div class="card-header bg-danger">
        <h4 class="text-white">Delete Leave Request</h4>
    </div>
    <div class="card-body table-secondary">
        @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!String.IsNullOrEmpty(Model.ViewModelSuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i>
                <span class="fw-bold">@Model.ViewModelSuccessMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!String.IsNullOrEmpty(Model.ViewModelWarningMessage))
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle"></i>
                <span class="fw-bold">@Model.ViewModelWarningMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <form asp-area="LVM" asp-controller="Leave" asp-action="DeleteLeaveRequest" method="post" autocomplete="off">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="LeaveEmployeeName" class="form-label text-dark">Employee Name</label>
                    <input asp-for="LeaveEmployeeName" class="form-control fw-bold" readonly>
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="LeaveYear" class="form-label text-dark">Year</label>
                    <input asp-for="LeaveYear" class="form-control fw-bold" readonly>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="LeaveTypeCode" class="form-label text-dark">Type</label>
                    <input asp-for="LeaveTypeName" class="form-control fw-bold" readonly>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="RequestedStartDate" class="form-label text-dark">Starts On:</label>
                    <div class="form-control fw-bold">@Model.RequestedStartDate.ToLongDateString()</div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label text-dark">Leave Duration</label>
                    <div class="form-control fw-bold">@Model.RequestedDurationDescription</div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label text-dark">Ends On:</label>
                    <div class="form-control fw-bold">@Model.RequestedEndDate.ToLongDateString()</div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label text-dark">Resumes Work On:</label>
                    @if (Model.RequestedResumptionDate == null)
                    {
                        <div class="form-control fw-bold"> [Not Set] </div>
                    }
                    else
                    {
                        <div class="form-control fw-bold">@Model.RequestedResumptionDate.Value.ToLongDateString()</div>
                    }
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="LeaveReason" class="form-label text-dark">Reason <small>(optional)</small></label>
                    <textarea asp-for="LeaveReason" class="form-control fw-bold" readonly>@Model.LeaveReason</textarea>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label text-dark fw-bold">Status:</label>
                    <div class="form-control fw-bold">@Model.LeaveRequestStatusDescription</div>
                </div>
                <div class="col-md-9 text-end mt-4">
                    <a asp-area="LVM" asp-controller="Leave" asp-action="MyLeaveRecords" class="btn btn-dark" style="width:100px" title="Exit">
                        <span class="text-white">Exit</span>
                    </a>
                    <button type="submit" class="btn btn-danger" title="Delete" style="width: 200px;" onclick="return confirm('Delete record will be deleted permanently. Do you still want to proceed?')"><span class="text-white">Delete</span></button>
                </div>
            </div>
            <input type="hidden" asp-for="LeaveRequestId">
            <input type="hidden" asp-for="LeaveEmployeeId" />
            <input type="hidden" asp-for="LeaveEmployeeName" />
            <input type="hidden" asp-for="LeaveRequestStatusId" />
        </form>
    </div>
</div>
@section Scripts{
    <script src="~/js/lvs.js"></script>
}

