
@model IntranetPortal.Areas.LVM.Models.LeaveDocumentViewModel
<h3 class="mb-1">My Leave Plans</h3>
<hr />

<div>
    <div class="card" style="max-width:700px">
        <div class="card-header bg-info">
            <h4 class="text-white">Upload Document</h4>
        </div>
        <div class="card-body bg-secondary">
            @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-x-circle"></i>
                    <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (!String.IsNullOrEmpty(Model.ViewModelSuccessMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i>
                    <span class="fw-bold">@Model.ViewModelSuccessMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (!String.IsNullOrEmpty(Model.ViewModelWarningMessage))
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle"></i>
                    <span class="fw-bold">@Model.ViewModelWarningMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        <form asp-area="LVM" asp-controller="Leave" asp-action="UploadDocument" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="col-md-12 mb-2">
                    <input type="hidden" asp-for="LeaveRequestId" />
                    <label class="form-label text-white fw-bold"> Title </label>
                    <input asp-for="DocumentTitle" class="form-control fw-bold" autocomplete="off">
                    <div><span asp-validation-for="DocumentTitle" class="text-danger"></span></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 mb-2">
                    <label class="form-label text-white fw-bold"> Description </label>
                    <textarea asp-for="DocumentDescription" class="form-control fw-bold" rows="3">@Model.DocumentDescription</textarea>
                    <div><span asp-validation-for="DocumentDescription" class="text-danger"></span></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 mb-2">
                    <label class="form-label text-white fw-bold">Select File</label><span class="text-white fw-light">  (Supported Formats: jpg, jpeg, png, gif, mp3, mp4)</span>
                    <input asp-for="MediaFile" class="form-control fw-bold">
                    <div><span asp-validation-for="MediaFile" class="text-danger"></span></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 mb-2 text-end">
                    <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveDocuments" asp-route-id="@Model.LeaveRequestId" class="btn btn-dark ml-2" style="width:100px" title="Exit">
                        <span class="text-white">Back</span>
                    </a>
                    @if (!Model.OperationIsCompleted)
                    {
                        <button type="submit" class="btn btn-primary ml-2" title="Save" style="width:200px"><span class="text-white">Upload</span></button>
                    }
                </div>
            </div>
        </form>
        </div>
    </div>
</div>
