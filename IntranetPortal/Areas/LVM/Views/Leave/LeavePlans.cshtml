@model IntranetPortal.Areas.LVM.Models.LeavePlansListViewModel
<div class="container">
    <h4 class="mb-1">Search Leave Plans</h4>
    <hr />
    <div class="mb-2">
        <div class="row">
            <div class="col-md-2">
                <a asp-area="LVM" asp-controller="Leave" asp-action="Dashboard" class="btn btn-sm btn-dark" style="width:100px;" title="Exit">
                    <span class="text-white">Back</span>
                </a>
            </div>
            <div class="col-md-10">
                <form asp-area="LVM" asp-controller="Leave" asp-action="LeavePlans" method="get">
                    <div class="row">
                        <div class="col-md-2">
                            <select asp-for="l" asp-items="@ViewBag.LocationList" class="form-control fw-bold">
                                <option value=""> Location </option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select asp-for="u" asp-items="@ViewBag.UnitList" class="form-control fw-bold">
                                <option value=""> Unit </option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <span class="text-dark fw-bold">Year: </span>
                            <input asp-for="y" class="border-0" style="width:75px" min="2020" max="2060">
                        </div>
                        <div class="col-md-2">
                            <span class="text-dark fw-bold">Month: </span>
                            <select asp-for="m" class="border-0" style="width:75px">
                                <option value="0"> All </option>
                                <option value="1"> Jan </option>
                                <option value="2"> Feb </option>
                                <option value="3"> Mar </option>
                                <option value="4"> Apr </option>
                                <option value="5"> May </option>
                                <option value="6"> Jun </option>
                                <option value="7"> Jul </option>
                                <option value="8"> Aug </option>
                                <option value="9"> Sep </option>
                                <option value="10"> Oct </option>
                                <option value="11"> Nov </option>
                                <option value="12"> Dec </option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <input asp-for="n" id="sn" class="border-0" placeholder="Name">
                        </div>
                        <div class="col-md-1">
                            <input type="submit" value="Search" class="btn btn-dark btn-sm text-white" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <hr />

        @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>
    <div class="row">
        @if (Model == null || Model.LeavePlanList == null || Model.LeavePlanList.Count < 1)
        {
            <div class="alert alert-info fade show" role="alert">
                <i class="bi bi-info-circle"></i>
                <span class="fw-bold">No record was found.</span>
            </div>
        }
        else
        {
            <div class="table-responsive" style="min-height:450px">
                @foreach (var plan in Model.LeavePlanList)
                {
                    <div class="card">
                        <div class="card-header bg-info">
                            <div class="row">
                                <div class="col-md-2" title="Leave Year">
                                    @if (plan.LeaveYear < 1)
                                    {
                                        <span class="fw-bold text-white" title="Leave Year"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i> [Unspecified]</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-white" title="Leave Year"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i> @plan.LeaveYear.ToString()</span>
                                    }
                                </div>
                                <div class="col-md-4" title="Employee Name">
                                    <span class="fw-bold text-white" title="Employee Name"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> @plan.LeaveEmployeeName</span>
                                </div>
                                <div class="col-md-3 text-center" title="Leave Type">
                                    @if (string.IsNullOrWhiteSpace(plan.LeaveTypeName))
                                    {
                                        <span class="fw-bold text-white" title="Leave Type"><i class="bi bi-signpost" style="font-size:1.2rem; font-weight:bold"></i> [Not Specified] </span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-white" title="Leave Type"><i class="bi bi-signpost" style="font-size:1.2rem; font-weight:bold"></i> @plan.LeaveTypeName</span>
                                    }
                                </div>
                                <div class="col-md-3">
                                    <div class="row">
                                      <div class="col-md-8 text-end">
                                          @if(plan.LeavePlanIsReturned)
                                          {
                                            <button title="Unflag this Leave Plan" target="_blank" class="btn btn-success btn-sm" style="border-radius:5px; border-color:#fff;" onclick="unflagLeavePlan(@plan.LeavePlanId);">
                                           <span class="text-white fw-bold"><i class="bi bi-flag"></i> Unflag this Plan</span>
                                       </button>
                                          }
                                          else
                                          {
                                        <a asp-area="LVM" asp-controller="Leave" asp-action="FlagLeavePlan" asp-route-id="@plan.LeavePlanId" asp-route-tp="p" title="Opens a new Tab" target="_blank" class="btn btn-danger btn-sm" style="border-radius:5px; border-color:#fff;">
                                           <span class="text-white fw-bold"><i class="bi bi-flag"></i> Flag this Plan</span>
                                       </a>
                                          }
                                    </div>
                                    <div class="col-md-4">
                                         <div class="dropdown">
                                        <button class="btn btn-info btn-sm" type="button" id="dropdownMenuButton2" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius:5px; border-color:#fff;">
                                            <span class="fw-bold text-white"><i class="bi bi-tools"></i> Options</span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                            <li>
                                                <a asp-area="LVM" asp-controller="Leave" asp-action="ViewLeavePlan" asp-route-id="@plan.LeavePlanId" title="View Details" class="dropdown-item">
                                                    <span class="text-white"><i class="bi bi-info-circle"></i> View Details</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveApprovals" asp-route-id="@plan.LeavePlanId" asp-route-sp="slp" asp-route-yr="@plan.LeaveYear" title="View Approvals" class="dropdown-item">
                                                    <span class="text-white"><i class="bi bi-calendar-check"></i> View Approvals</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveNotes" asp-route-pd="@plan.LeavePlanId" asp-route-sp="slp" asp-route-yr="@plan.LeaveYear" title="View Notes" class="dropdown-item">
                                                    <span class="text-white"><i class="bi bi-journals"></i> View Notes</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveActivities" asp-route-pd="@plan.LeavePlanId" title="Activity Log" class="dropdown-item">
                                                    <span class="text-white"><i class="bi bi-file-earmark-text"></i> View History</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body" style="background-color:#BDDFF2">
                            <div class="row">
                                <div class="col-md-4" title="Start Date">
                                    @if (plan.LeavePlanStartDate == null)
                                    {
                                        <span class="fw-bold text-dark" title="Start Date"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i> Start Date: [Unspecified]</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-dark" title="Start Date"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i> Start Date: @plan.LeavePlanStartDate.Value.ToLongDateString()</span>
                                    }
                                </div>
                                <div class="col-md-4" title="Duration">
                                    @if (string.IsNullOrWhiteSpace(plan.LeavePlanDurationDescription))
                                    {
                                        <span class="fw-bold text-dark" title="Duration"><i class="bi bi-clock" style="font-size:1.2rem; font-weight:bold"></i> Duration: [N/A]</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-dark" title="Duration"><i class="bi bi-clock" style="font-size:1.2rem; font-weight:bold"></i> Duration: @plan.LeavePlanDurationDescription</span>
                                    }
                                </div>
                                <div class="col-md-4" title="Resumption Date">
                                    @if (plan.LeavePlanResumptionDate == null)
                                    {
                                        <span class="fw-bold text-dark" title="Resumption Date"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i> Resumption Date: [Unspecified]</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-dark" title="Resumption Date"><i class="bi bi-calendar" style="font-size:1.0rem; font-weight:bold"></i> Resumption Date: @plan.LeavePlanResumptionDate.Value.ToLongDateString()</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
@section Scripts{
     <script src="~/js/lvs.js"></script>
}