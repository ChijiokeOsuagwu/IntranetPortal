@model IntranetPortal.Areas.LVM.Models.LeaveSubmittedToHrListViewModel
<div class="container">
    <h4 class="mb-1"> Submitted Leave Requests </h4>
    <hr />
    <div class="mb-2">
        <form asp-area="LVM" asp-controller="Leave" asp-action="LeaveSubmittedToHr" method="get">
            <div class="row">
                <div class="col-md-4">
                    <a asp-area="LVM" asp-controller="Leave" asp-action="Dashboard" class="btn btn-sm btn-dark" style="width:100px;" title="Exit">
                        <span class="text-white">Back</span>
                    </a>
                </div>
                <div class="col-md-8 text-end">
                    <span class="text-dark fw-bold">Select Year: </span>
                    <input asp-for="yr" class="border-0 mr-3 ml-2" style="width:100px" min="2020" max="2060">
                    <input type="submit" value="Search" class="btn btn-sm btn-dark mr-3 text-white" style="width:100px;" />
                </div>
            </div>
        </form>
        @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>
    <hr />
    @if (Model == null || Model.LeaveSubmissionList == null || Model.LeaveSubmissionList.Count < 1)
    {
        <div class="alert alert-info fade show" role="alert">
            <i class="bi bi-info-circle"></i>
            <span class="fw-bold">No record was found.</span>
        </div>
    }
    else
    {
        int row_no = 0;
        <div class="table-responsive" style="min-height:450px">
            <!-- Beginning of Accordion -->
            <div class="accordion" id="accordionExample">
                @foreach (var submission in Model.LeaveSubmissionList)
                {
                    row_no++;
                    @if (submission.LeavePlanId > 0)
                    {
                        <div class="accordion-item">
                            <h4 class="accordion-header" id="heading_@row_no">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@row_no" aria-expanded="false" aria-controls="collapse_@row_no">
                                    <span class="fw-bold text-dark"><i class="bi bi-person-fill" style="font-size:1.2rem;"></i> @submission.FromEmployeeName</span>
                                </button>
                            </h4>
                            <div id="collapse_@row_no" class="accordion-collapse collapse" aria-labelledby="heading_@row_no" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
                                    <div class="card mt-1" style="max-width:1000px">
                                        <div class="card-header bg-info">
                                            <h4 class="text-white"> @submission.LeavePlanYear | Leave Plan </h4>
                                        </div>
                                        <div class="card-body table-secondary">
                                            <div class="row">
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-white fw-bold">Type</label>
                                                    <div class="form-control fw-bold">@submission.LeavePlanTypeName</div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-white fw-bold">Duration</label>
                                                    <div class="form-control fw-bold">@submission.LeavePlanDurationDescription</div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-white fw-bold">Status</label>
                                                    <div class="form-control fw-bold">@submission.LeavePlanStatusDescription</div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-white fw-bold">Leave Starts On:</label>
                                                    <div class="form-control fw-bold">@submission.LeavePlanStartDate.ToLongDateString()</div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-white fw-bold">Leave Ends On:</label>
                                                    <div class="form-control fw-bold">@submission.LeavePlanEndDate.ToLongDateString()</div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-white fw-bold">Resumes Work On:</label>
                                                    <div class="form-control fw-bold">@submission.LeavePlanResumptionDate.ToLongDateString()</div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-white fw-bold">Staff</label>
                                                    <div class="form-control fw-bold">@submission.LeavePlanEmployeeName</div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-white fw-bold">Location</label>
                                                    <div class="form-control fw-bold">@submission.LeavePlanLocationName</div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-white fw-bold">Duration</label>
                                                    <div class="form-control fw-bold">@submission.LeavePlanUnitName</div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-9 text-end">
                                                    <a asp-area="LVM" asp-controller="Leave" asp-action="LeavePlanDecline" asp-route-id="@submission.LeavePlanId" asp-route-sd="@submission.LeaveSubmissionId" asp-route-sp="lsh" class="btn btn-danger" style="width: 120px; border-radius: 5px;" title="Decline">
                                                        <span class="text-white"><i class="bi bi-x-lg"></i> Decline</span>
                                                    </a>
                                                    <button class="btn btn-success" title="Approve this Leave Request" style="width: 120px; border-radius: 5px;">
                                                        <span class="text-white"><i class="bi bi-check-lg"></i> Approve</span>
                                                    </button>
                                                </div>
                                                <div class="col-md-3 text-end">
                                                    <div class="dropdown">
                                                        <button class="btn btn-dark" type="button" id="dropdownMenuButton2" data-bs-toggle="dropdown" aria-expanded="false" style="width:100px; border-radius:5px;">
                                                            <span class="text-white"><i class="bi bi-tools"></i> Options</span>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                                            <li>
                                                                <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveDocuments" asp-route-id="@submission.LeavePlanId" asp-route-sp="lsh" asp-route-sd="@submission.LeaveSubmissionId" title="View Attachments" class="dropdown-item">
                                                                    <span class="text-white"><i class="bi bi-paperclip"></i> View Attachments </span>
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveApprovals" asp-route-pd="@submission.LeavePlanId" asp-route-sd="@submission.LeaveSubmissionId" asp-route-sp="lsh" title="View Approvals" class="dropdown-item">
                                                                    <span class="text-white"><i class="bi bi-calendar-check"></i> View Approvals</span>
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveNotes" asp-route-pd="@submission.LeavePlanId" asp-route-sp="lsh" asp-route-sd="@submission.LeaveSubmissionId" title="View Notes" class="dropdown-item">
                                                                    <span class="text-white"><i class="bi bi-journals"></i> View Notes</span>
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveActivities" asp-route-pd="@submission.LeavePlanId" title="Activity Log" class="dropdown-item">
                                                                    <span class="text-white"><i class="bi bi-file-earmark-text"></i> View History</span>
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="accordion-item">
                            <h4 class="accordion-header" id="heading_@row_no">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@row_no" aria-expanded="false" aria-controls="collapse_@row_no">
                                    <span class="fw-bold"><i class="bi bi-person"></i> @submission.FromEmployeeName</span>
                                </button>
                            </h4>
                            <div id="collapse_@row_no" class="accordion-collapse collapse" aria-labelledby="heading_@row_no" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
                                    <div class="card mt-1" style="max-width:1000px">
                                        <div class="card-header" style="background-color: #198754;">
                                            <h4 class="text-white"> @submission.LeaveRequestYear | Leave Request </h4>
                                        </div>
                                        <div class="card-body table-secondary">
                                            <div class="row">
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-dark fw-bold">Type</label>
                                                    <div class="form-control fw-bold">@submission.LeaveRequestTypeName</div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-dark fw-bold">Duration</label>
                                                    <div class="form-control fw-bold">@submission.LeaveRequestDurationDescription</div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-dark fw-bold">Status</label>
                                                    @if (submission.LeaveRequestStatusDescription == "Approved")
                                                    {
                                                        <div class="form-control fw-bold" style="background-color: #198754; color:#fff">@submission.LeaveRequestStatusDescription</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="form-control fw-bold">@submission.LeaveRequestStatusDescription</div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-dark fw-bold">Leave Starts On:</label>
                                                    <div class="form-control fw-bold">@submission.LeaveRequestStartDate.ToLongDateString()</div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-dark fw-bold">Leave Ends On:</label>
                                                    <div class="form-control fw-bold">@submission.LeaveRequestEndDate.ToLongDateString()</div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-dark fw-bold">Resumes Work On:</label>
                                                    <div class="form-control fw-bold">@submission.LeaveRequestResumptionDate.ToLongDateString()</div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-dark fw-bold">Staff</label>
                                                    <div class="form-control fw-bold">@submission.LeaveRequestEmployeeName</div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-dark fw-bold">Location</label>
                                                    <div class="form-control fw-bold">@submission.LeaveRequestLocationName</div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label text-dark fw-bold">Unit</label>
                                                    <div class="form-control fw-bold">@submission.LeaveRequestUnitName</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-footer" style="background-color: #198754;">
                                            <div class="row">
                                                <div class="col-md-8 text-end">
                                                    @if (!submission.IsActioned)
                                                    {
                                                        <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveRequestDecline" asp-route-id="@submission.LeaveRequestId" asp-route-sd="@submission.LeaveSubmissionId" asp-route-sp="lsh" class="btn btn-sm btn-danger" style="width: 120px; border-radius: 5px; border-color: #fff;" title="Decline">
                                                            <span class="text-white"><i class="bi bi-x-lg"></i> Decline</span>
                                                        </a>
                                                        <button class="btn btn-sm btn-success" title="Approve this Leave Request" style="width: 120px; border-radius: 5px; background-color: #198754; border-color: #fff; " onclick="approveLeaveRequest(@submission.LeaveRequestId, @submission.LeaveSubmissionId)">
                                                            <span class="text-white"><i class="bi bi-check-lg"></i> Approve</span>
                                                        </button>
                                                    }
                                                </div>
                                                <div class="col-md-2 text-end">
                                                    <button class="btn btn-sm" title="Remove from this List" style="width: 120px; border-radius: 5px; border-color: #fff; background-color: #198754;" onclick="deleteLeaveSubmission(@submission.LeaveSubmissionId)">
                                                        <span class="text-white"><i class="bi bi-file-earmark-x"></i> Remove</span>
                                                    </button>
                                                </div>
                                                <div class="col-md-2 text-end">
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-dark" type="button" id="dropdownMenuButton2" data-bs-toggle="dropdown" aria-expanded="false" style="width: 100px; border-radius: 5px; border-color: #fff; ">
                                                            <span class="text-white"><i class="bi bi-tools"></i> Options</span>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                                            <li>
                                                                <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveDocuments" asp-route-id="@submission.LeaveRequestId" asp-route-sp="lsh" asp-route-sd="@submission.LeaveSubmissionId" title="View Attachments" class="dropdown-item">
                                                                    <span class="text-white"><i class="bi bi-paperclip"></i> View Attachments </span>
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveApprovals" asp-route-rd="@submission.LeaveRequestId" asp-route-sd="@submission.LeaveSubmissionId" asp-route-sp="lsh" title="View Approvals" class="dropdown-item">
                                                                    <span class="text-white"><i class="bi bi-calendar-check"></i> View Approvals</span>
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveNotes" asp-route-rd="@submission.LeaveRequestId" asp-route-sp="lsh" asp-route-sd="@submission.LeaveSubmissionId" title="View Notes" class="dropdown-item">
                                                                    <span class="text-white"><i class="bi bi-journals"></i> View Notes</span>
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveActivities" asp-route-rd="@submission.LeaveRequestId" title="Activity Log" class="dropdown-item">
                                                                    <span class="text-white"><i class="bi bi-file-earmark-text"></i> View History</span>
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <!-- End of Accordion -->
        </div>
    }
</div>
@section Scripts{
    <script src="~/js/lvs.js"></script>
}
