
@model IntranetPortal.Areas.LVM.Models.AnnualLeaveSummaryReportViewModel
<div class="container">
    <h4 class="mb-1">Annul Leave Summary Report</h4>
    <hr />
        <div class="row">
            <div class="col-md-12 mb-3 text-start">
                <a asp-area="LVM" asp-controller="Leave" asp-action="Dashboard" title="Go Back" class="btn btn-sm btn-outline-light text-dark">
                    <i class="bi bi-backspace fw-bolder" style="font-size: 1.0rem;"></i><span class="fw-bold ml-1" style="font-size: 0.9rem;">Back</span>
                </a>
                <a asp-area="LVM" asp-controller="Leave" asp-action="DownloadAnnualLeaveSummaryReport" asp-route-yr="@Model.yr" asp-route-ud="@Model.ud" asp-route-dd="@Model.dd" asp-route-ld="@Model.ld" asp-route-sn="@Model.sn" title="Download Excel" class="btn btn-sm btn-outline-light ml-2 text-dark">
                    <i class="bi bi-download fw-bolder" style="font-size: 1.0rem;"></i><span class="fw-bold ml-1" style="font-size: 0.9rem;">Download</span>
                </a>
            </div>
        </div>
        <div class="row">
            <form asp-area="LVM" asp-controller="Leave" asp-action="AnnualLeaveSummaryReport" method="get">
                <div class="row">
                    <div class="col-md-2 mb-2">
                        <select asp-for="ld" asp-items="@ViewBag.LocationList" class="form-select fw-bold">
                            <option value="0"> Location </option>
                        </select>
                    </div>
                    <div class="col-md-2 mb-2">
                        <select asp-for="dd" asp-items="@ViewBag.DepartmentList" class="form-select fw-bold">
                            <option value="0"> Department </option>
                        </select>
                    </div>
                    <div class="col-md-2 mb-2">
                        <select asp-for="ud" asp-items="@ViewBag.UnitList" class="form-select fw-bold">
                            <option value="0"> Unit </option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-2">
                        <input asp-for="sn" id="sn" class="form-control fw-bold" placeholder="Enter Name" />
                    </div>
                    <div class="col-md-2 mb-2">
                        <input asp-for="yr" class="fw-bold" type="number" min="2025" max="2060" style="width:75px; height:35px; padding:3px; border:1px solid #F5F0F0" />
                        <input type="submit" value="Search" class="btn btn-dark btn-sm text-white" style="border-radius:5px; width:75px;"/>
                    </div>
                </div>
            </form>
        </div> 
    <hr>
    @if (!string.IsNullOrEmpty(Model.ViewModelErrorMessage))
    {<div class="row">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }
    <div class="row">
        @if (Model == null || Model.AnnualLeaveSummaryList == null || Model.AnnualLeaveSummaryList.Count < 1)
        {
            <div class="alert alert-info fade show" role="alert">
                <i class="bi bi-info-circle"></i>
                <span class="fw-bold">No record was found.</span>
            </div>
        }
        else
        {
            int row_no = 0;
            <div class="row">
                <div class="table-responsive" style="max-height:450px;">
                    <table class="table table-sm table-striped caption-top">
                        <thead class="table-dark">
                            <tr>
                                <th colspan="11" class="text-center"><span class="text-white fw-bold" style="font-size:1.2rem">@Model.ReportHeaderTitle</span></th>
                            </tr>
                            <tr>
                                <th><span class="text-white fw-bold">#</span></th>
                                <th><span class="text-white fw-bold">Name</span></th>
                                <th><span class="text-white fw-bold">Annual Leave</span></th>
                                <th><span class="text-white fw-bold">Prev.Bal</span></th>
                                <th><span class="text-white fw-bold">Used</span></th>
                                <th><span class="text-white fw-bold">Added</span></th>
                                <th><span class="text-white fw-bold">Deducted</span></th>
                                <th><span class="text-white fw-bold">Unused</span></th>
                                <th><span class="text-white fw-bold">Unit</span>
                                <th><span class="text-white fw-bold">Department</span></th>
                                <th><span class="text-white fw-bold">Location</span></th>
                            </tr>
                        </thead>
                        <tbody class="table-light">
                            @foreach (var item in Model.AnnualLeaveSummaryList)
                            {
                                row_no++;
                                <tr>
                                    <td><span class="fw-bold">@row_no.ToString()</span></td>
                                    <td><span class="fw-bold">@item.EmployeeName</span></td>
                                    <td><span class="fw-bold">@item.NumberOfAnnualLeaveDaysDue</span></td>
                                    <td><span class="fw-bold">@item.PreviousYearsBalanceBroughtFoward</span></td>
                                    <td><span class="fw-bold">@item.NumberOfDaysUsed</span></td>
                                    <td><span class="fw-bold">@item.NumberOfDaysAdded</span></td>
                                    <td><span class="fw-bold">@item.NumberOfDaysDeducted</span></td>
                                    <td><span class="fw-bold">@item.NumberOfDaysUnused</span></td>
                                    <td><span class="fw-bold">@item.UnitName</span></td>
                                    <td><span class="fw-bold">@item.DepartmentName</span></td>
                                    <td><span class="fw-bold">@item.LocationName</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts{
   <script src="~/js/lvs.js"></script>
}




