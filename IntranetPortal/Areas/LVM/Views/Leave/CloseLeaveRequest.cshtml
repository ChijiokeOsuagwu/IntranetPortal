@model IntranetPortal.Areas.LVM.Models.CloseLeaveRequestViewModel
<h4 class="mb-1">OfficeManager | Leave Management System </h4>
<hr />
<div class="card mt-1" style="max-width:1000px">
    <div class="card-header" style="background-color:#035711">
        <h4 class="text-white">Close Leave Request</h4>
    </div>
    <div class="card-body table-secondary" >
        @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!String.IsNullOrEmpty(Model.ViewModelSuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i>
                <span class="fw-bold">@Model.ViewModelSuccessMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!String.IsNullOrEmpty(Model.ViewModelWarningMessage))
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle"></i>
                <span class="fw-bold">@Model.ViewModelWarningMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    <form asp-area="LVM" asp-controller="Leave" asp-action="CloseLeaveRequest" method="post" autocomplete="off">
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="LeaveEmployeeName" class="form-label text-dark">Employee Name</label>
                <input asp-for="LeaveEmployeeName" class="form-control fw-bold" readonly>
            </div>
            <div class="col-md-2 mb-3">
                <label asp-for="LeaveYear" class="form-label text-dark">Year</label>
                <input asp-for="LeaveYear" class="form-control fw-bold" min="2020" max="2060" readonly>
                <div><span asp-validation-for="LeaveYear" class="text-danger"></span></div>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="LeaveTypeName" class="form-label text-dark">Type</label>
                <input asp-for="LeaveTypeName" class="form-control fw-bold" readonly />
                <div><span asp-validation-for="LeaveTypeName" class="text-danger"></span></div>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label text-dark">Duration</label>
                <input asp-for="RequestedDurationDescription" class="form-control fw-bold" readonly>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label text-dark">Approved Start Date:</label>
                <div class="form-control fw-bold">@Model.RequestedStartDate.ToLongDateString()</div>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label text-dark">Approved End Date:</label>
                <div class="form-control fw-bold">@Model.RequestedEndDate.ToLongDateString()</div>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label text-dark">Approved Resumption Date:</label>
                <div class="form-control fw-bold">@Model.RequestedResumptionDate.Value.ToLongDateString()</div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label text-dark">Actual Start Date:</label>
                <input asp-for="ActualLeaveStartDate" class="form-control fw-bold" type="date" autofocus>
                <div><span asp-validation-for="ActualLeaveStartDate" class="text-danger"></span></div>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label text-dark">Actual End Date:</label>
                <input asp-for="ActualLeaveEndDate" id="ActualLeaveEndDate" class="form-control fw-bold" type="date">
                <div><span id="actualEndDateErrorSpan" asp-validation-for="ActualLeaveEndDate" class="text-danger"></span></div>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label text-dark">Actual Resumption Date:</label>
                <input asp-for="HrResumptionDate"  class="form-control fw-bold" type="date">
                <div><span asp-validation-for="HrResumptionDate" class="text-danger"></span></div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 text-end">
                <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveRequestsDueResumption" class="btn btn-dark" style="width:100px" title="Exit">
                    <span class="text-white">Exit</span>
                </a>
                @if (!Model.OperationIsSuccessful)
                {
                    <button type="submit" class="btn" title="Close" style="width: 200px; background-color:#035711"><span class="text-white">Close</span></button>
                }
            </div>
        </div>
        <input type="hidden" asp-for="LeaveRequestId">
        <input type="hidden" asp-for="LeaveEmployeeId" />
        <input type="hidden" asp-for="LeaveRequestStatusId" />
        <input type="hidden" asp-for="LeaveTypeCode" />
        <input type="hidden" asp-for="RequestedStartDate" />
        <input type="hidden" asp-for="RequestedEndDate" />
        <input type="hidden" asp-for="RequestedResumptionDate" />
        <input type="hidden" asp-for="ActualLeaveDuration"/>
        <input type="hidden" asp-for="LeaveUnitId" />
        <input type="hidden" asp-for="LeaveDepartmentId" />
        <input type="hidden" asp-for="LeaveLocationId" />
    </form>
    </div>
</div>
@section Scripts{
    <script src="~/js/lvs.js"></script>
}
