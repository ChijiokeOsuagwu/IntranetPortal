@model IntranetPortal.Areas.LVM.Models.LeaveDocumentListViewModel
<div class="container">
    <h4 class="mb-4">Leave Managment System | Leave Documents</h4>
    <hr />
    <div class="mb-3">
        @if (Model.src == "lra" || Model.SourcePage == "lra")
        {
            <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveRequestApproval" asp-route-id="@Model.LeaveRequestId" asp-route-sd="@Model.SubmissionId" class="btn btn-dark" style="width:100px" title="Click to Go Back">
                <span class="text-white">Back</span>
            </a>
        }
        else if (Model.src == "lsh" || Model.SourcePage == "lsh")
        {
            <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveSubmittedToHr" class="btn btn-dark" style="width:100px" title="Click to Go Back">
                <span class="text-white">Back</span>
            </a>
        }
        else if (Model.src == "hlr" || Model.SourcePage == "hlr")
        {
            <a asp-area="LVM" asp-controller="Leave" asp-action="LeaveRecords" class="btn btn-dark" style="width:100px" title="Click to Go Back">
                <span class="text-white">Back</span>
            </a>
        }
        else
        {
            <a asp-area="LVM" asp-controller="Leave" asp-action="MyLeaveRecords" class="btn btn-dark" style="width:100px" title="Click to Go Back">
                <span class="text-white">Back</span>
            </a>
        }
        <a asp-area="LVM" asp-controller="Leave" asp-action="UploadDocument" asp-route-id="@Model.LeaveRequestId" title="Upload New Document" class="btn btn-sm btn-dark">
            <i class="bi bi-upload mr-2" style="font-size: 1.0rem;"></i> <span class="text-white">New Upload</span>
        </a>
    </div>
    <hr />
    @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-x-circle"></i>
            <span class="fw-bold">@Model.ViewModelErrorMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!String.IsNullOrEmpty(Model.ViewModelSuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i>
            <span class="fw-bold">@Model.ViewModelSuccessMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (Model == null || Model.LeaveDocumentList == null || Model.LeaveDocumentList.Count < 1)
    {
        <div class="alert alert-info fade show" role="alert">
            <i class="bi bi-info-circle"></i>
            <span class="fw-bold">No record was found.</span>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var document in Model.LeaveDocumentList)
            {
                <div class="col-lg-3 col-sm-6">
                    <div class="card">
                        <div class="card-body text-center">
                            <a href="@document.DocumentReferencePath" target="_blank" rel="noopener noreferrer" title="Click to Open in a new Tab.">
                                <span class="fw-bold text-dark"><i class="bi bi-file-pdf" style="font-size:5rem"></i></span>
                            </a>
                            <h5 class="fw-bold text-dark"> @document.DocumentTitle</h5>
                            <form asp-area="LVM" asp-controller="Leave" asp-action="DeleteDocument" asp-route-id="@document.LeaveDocumentId" asp-route-rd="@document.LeaveRequestId" method="post">
                                <button type="submit" onclick="return confirm('Are you sure you want to delete this media permanently?')" style="border:none; padding:0px">
                                    <i class="bi bi-trash-fill mr-2" style="font-size: 0.9rem; color:black"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
