@model IntranetPortal.Areas.GlobalSettings.Models.LocationGroupViewModel
@{
    ViewData["Title"] = "Location Settings | Add Location Group";
}
<div class="card ml-5 mt-5 w-50">
    <div class="card-header bg-dark">
        @if (Model.LocationGroupId < 1)
        {
            <h4 class="text-white">New Location Group</h4>
        }
        else
        {
            <h4 class="text-white">Edit Location Group</h4>
        }
    </div>
    <div class="card-body bg-secondary">
        @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!String.IsNullOrEmpty(Model.ViewModelSuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i>
                <span class="fw-bold">@Model.ViewModelSuccessMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!String.IsNullOrEmpty(Model.ViewModelWarningMessage))
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle"></i>
                <span class="fw-bold">@Model.ViewModelWarningMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <form asp-area="GlobalSettings" asp-controller="Locations" asp-action="ManageLocationGroup" method="post">
            <div class="row">
                <div class="col-mb-12 mb-3">
                    <input type="hidden" asp-for="LocationGroupId" />
                    <label asp-for="LocationGroupName" class="form-label text-white fw-bold"></label>
                    <input asp-for="LocationGroupName" class="form-control" placeholder="Enter Name" autocomplete="off">
                    <div><span asp-validation-for="LocationGroupName" class="text-danger"></span></div>
                </div>
            </div>
            <div class="row">
                <a asp-area="GlobalSettings" asp-controller="Locations" asp-action="LocationGroups" class="btn btn-dark" style="width:100px" title="Return to Location Groups">
                    <span class="text-white">Go Back</span>
                </a>&nbsp;
                <a asp-area="GlobalSettings" asp-controller="Locations" asp-action="AddLocationGroup" class="btn btn-warning" style="width:100px" title="Clear">
                    <span class="text-white">Clear</span>
                </a>&nbsp;
                @if (!Model.OperationIsCompleted)
                {
                    <button type="submit" class="btn btn-primary" title="Save" style="width:200px"><span class="text-white">Save</span></button>
                }
            </div>
        </form>
    </div>
</div>