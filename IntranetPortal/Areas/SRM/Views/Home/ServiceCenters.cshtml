@model IntranetPortal.Areas.SRM.Models.ServiceCentersListViewModel
<div class="container">
    <h4 class="mb-1">Service Request Manager | Service Centers </h4>
    <hr />
    <div class="row">
        <div class="col-md-4 mb-1">
            <a asp-area="SRM" asp-Controller="Home" asp-action="Settings" title="Go Back" class="btn btn-sm btn-info text-white" style="width:75px; border-radius:5px">
                Back
            </a>
        </div>
        <div class="col-md-4 mb-1">
            <input type="hidden" id="cntr_id" value="" />
            <div id="div-error" class="text-danger"></div>
            <input id="cntr_name" class="form-control form-control-sm" placeholder="Enter Center Name" aria-label="Enter Name" style="font-size:14px; font-weight:bold; min-width:250px; min-height:25px" required>
        </div>
        <div class="col-md-4 mb-1">
            <button class="btn btn-sm btn-info" type="button" id="add" style="width:100px; border-radius:5px" onclick="addServiceCenter()">Save</button>
        </div>
    </div>
    <div class="row">
        <div>
            @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-x-circle"></i>
                    <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
        <div class="row">
            @if (Model == null || Model.ServiceCenterList == null || Model.ServiceCenterList.Count < 1)
            {
                <div class="alert alert-info fade show" role="alert">
                    <i class="bi bi-info-circle"></i>
                    <span class="fw-bold">No record was found.</span>
                </div>
            }
            else
            {
                int row_no = 0;
                <div class="row">
                    <div class="table-responsive" style="min-height:400px">
                        <table class="table table-sm table-secondary">
                            <thead>
                                <tr>
                                    <th class="bg-info text-white fw-bold">#</th>
                                    <th class="bg-info text-white fw-bold">Name</th>
                                    <th class="bg-info text-white fw-bold"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var center in Model.ServiceCenterList)
                                {
                                    row_no++;
                                    <tr>
                                        <td>@row_no.ToString()</td>
                                        <td>
                                            <span class="fw-bold">@center.Name</span>
                                        </td>
                                        <td>
                                            <div class="text-end">
                                                <button class="btn btn-primary btn-sm" onclick="populateCenterEditForm(@center.Id, '@center.Name')" style="width:75px; border-radius:5px">
                                                    <span class="text-white fw-bold"><i class="bi bi-pencil-square"></i> Edit</span>
                                                </button>
                                                <button class="btn btn-danger btn-sm" onclick="deleteServiceCenter(@center.Id)" style="width:75px; border-radius:5px">
                                                    <span class="text-white fw-bold"><i class="bi bi-trash"></i> Delete</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/srm.js"></script>
}



