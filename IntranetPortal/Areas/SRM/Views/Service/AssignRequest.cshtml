@model IntranetPortal.Areas.SRM.Models.AssignRequestViewModel
@{
    ViewData["Title"] = "Service Request Manager | Assign Request";
}
<div class="container">
    <h4 class="mb-1">Service Request Manager | New Request </h4>
    <hr />
    <div class="row">
        <div class="col-md-12 mb-1">
            <a asp-area="SRM" asp-Controller="Service" asp-action="ServiceRequestBoard" title="Go Back" class="btn btn-sm btn-info text-white" style="width:75px; border-radius:5px">
                Back
            </a>
        </div>
    </div>
    <div class="card" style="max-width:600px">
        <div class="card-header bg-info">
            <h4 class="text-white">Assign Request</h4>
        </div>
        <div class="card-body bg-secondary">
            @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-x-circle"></i>
                    <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (!String.IsNullOrEmpty(Model.ViewModelSuccessMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i>
                    <span class="fw-bold">@Model.ViewModelSuccessMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (!String.IsNullOrEmpty(Model.ViewModelWarningMessage))
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle"></i>
                    <span class="fw-bold">@Model.ViewModelWarningMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <form asp-area="SRM" asp-controller="Service" asp-action="AssignRequest" method="post">
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <input type="hidden" asp-for="IncidentId" />
                        <input type="hidden" asp-for="ServiceTeamId" />
                        <label asp-for="AssignedToEmployeeName" class="form-label text-white fw-bold"></label>
                        <select asp-for="AssignedToEmployeeName" asp-items="@ViewBag.TeamMembersList" class="form-control fw-bold">
                            <option value=""> - Select - </option>
                        </select>
                        <div><span asp-validation-for="AssignedToEmployeeName" class="text-danger"></span></div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12 text-end">
                        <a asp-area="SRM" asp-controller="Service" asp-action="ServiceRequestBoard" class="btn btn-dark ml-2" style="width:75px" title="Exit">
                            <span class="text-white">Exit</span>
                        </a>
                        <a asp-area="SRM" asp-controller="Service" asp-action="NewRequest" class="btn btn-warning ml-1" style="width:75px" title="Clear">
                            <span class="text-white">Clear</span>
                        </a>
                        @if (!Model.OperationIsSuccessful)
                        {
                            <button type="submit" class="btn btn-info ml-2" title="Save" style="width:100px"><span class="text-white">Send</span></button>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/srm.js"></script>
}






