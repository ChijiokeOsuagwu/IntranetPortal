@model IntranetPortal.Areas.SRM.Models.RequestResolutionsListViewModel
<div class="container">
    <h4 class="mb-1">Service Request Manager | Request Resolutions</h4>
    <hr />
    <div class="row">
        <div class="col-md-3">
            <nav class="navbar navbar-expand-lg navbar-light bg-light">
                <div class="container-fluid">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNavDropdown">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a asp-area="SRM" asp-controller="Service" asp-action="ServiceRequestBoard" title="Go Back" class="btn btn-sm btn-outline-light text-dark">
                                    <i class="bi bi-backspace fw-bolder" style="font-size: 1.0rem;"></i> <span class="fw-bold ml-1" style="font-size: 0.9rem;">Back</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
        <div class="col-md-9 text-end">
            @if (Model.LoggedInEmployeeName == Model.AssignedToEmployeeName)
            {
                <a asp-area="SRM" asp-Controller="Service" asp-action="ManageRequestResolution" asp-route-rd="@Model.rd" title="Add New Resolution" class="btn btn-sm btn-info text-white" style="width:200px;">
                    <span class="text-white"><i class="bi bi-plus-lg"></i>Add New Resolution</span>
                </a>
            }
        </div>
    </div>
    <div class="row">
        @if (Model == null || Model.IncidentResolutionsList == null || Model.IncidentResolutionsList.Count < 1)
        {
            <div class="alert alert-secondary alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold text-dark">No record was found.</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else
        {
            int row_number = 0;
            <div class="table-responsive">
                @foreach (var resolution in Model.IncidentResolutionsList)
                {
                    row_number++;
                    <div class="card">
                            <div class="card-header bg-info">
                                <div class="row">
                                    <div class="col-md-5" title="Resolved By">
                                        <span class="fw-bold text-white" title="Resolved By"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> @resolution.ResolvedByEmployeeName</span>
                                    </div>
                                    <div class="col-md-4" title="Time Resolved">
                                        <span class="fw-bold text-white" title="Time Resolved"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> @resolution.ResolvedTime.Value.ToString("dd-MMM-yyyy ")   @resolution.ResolvedTime.Value.ToShortTimeString()</span>
                                    </div>
                                    <div class="col-md-3">
                                        @if (resolution.IsConfirmed)
                                        {
                                            <div class="fw-bold" style="color:white" title="Status">
                                                <i class="bi bi-check-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i> Confirmed
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fw-bold" style="font-size:1.0rem" title="Status">
                                                <i class="bi bi-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i>  Not Confirmed
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="card-body table-secondary">
                                <div class="row">
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label text-dark">Request No.</label>
                                        <input asp-for="@resolution.IncidentNumber" class="form-control fw-bold" readonly="readonly">
                                    </div>
                                 </div>
                                <div class="row">
                                    <div class="col-md-12 mb-2">
                                        <label class="form-label text-dark fw-bold">Request Description</label>
                                        <textarea asp-for="@resolution.IncidentDescription" class="form-control fw-bold" readonly>@resolution.IncidentDescription</textarea>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12 mb-2">
                                        <label class="form-label text-dark fw-bold">Request Resolution</label>
                                        <textarea asp-for="@resolution.ResolutionDescription" class="form-control fw-bold" rows="4" placeholder="Describe how the request or issue was resolved. Include the steps taken, final outcome, and any follow up needed.">@resolution.ResolutionDescription</textarea>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mt-1">
                                        <a asp-area="SRM" asp-controller="Service" asp-action="ManageRequestResolution" asp-route-id="@resolution.Id" asp-route-rd="@resolution.IncidentId" class="btn btn-sm btn-info" style="border-radius:5px; width:200px;" title="Edit">
                                            <span class="bi bi-pencil-square fw-bold" style="font-size:0.8rem; margin-right:2px; color:white"></span>
                                            <span class="text-white" style="font-size:0.8rem">Edit</span>
                                        </a>
                                        <button class="btn btn-sm btn-danger" style="border-radius:5px; width:200px;" title="Edit" onclick="deleteRequestResolution(@resolution.Id)">
                                            <span class="bi bi-trash fw-bold" style="font-size:0.8rem; margin-right:2px; color:white"></span>
                                            <span class="text-white" style="font-size:0.8rem">Delete</span>
                                        </button>
                                    </div>
                                    <div class="col-md-6 mt-4 text-end">
                                                

                                    </div>
                                </div>
                            </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
@section Scripts{
    <script src="~/js/srm.js"></script>
}
