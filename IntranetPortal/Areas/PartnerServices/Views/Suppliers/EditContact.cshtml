@model IntranetPortal.Areas.PartnerServices.Models.ContactViewModel
@{
    ViewData["Title"] = "OfficeManager | Edit Contact";
}
<div>
    <div class="card" style="min-width:600px">
        <div class="card-header bg-success">
            <h4 class="text-white">Edit Contact</h4>
        </div>
        <div class="card-body bg-secondary">
            @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-x-circle"></i>
                    <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (!String.IsNullOrEmpty(Model.ViewModelSuccessMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i>
                    <span class="fw-bold">@Model.ViewModelSuccessMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (!String.IsNullOrEmpty(Model.ViewModelWarningMessage))
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle"></i>
                    <span class="fw-bold">@Model.ViewModelWarningMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        <form asp-area="PartnerServices" asp-controller="Suppliers" asp-action="EditContact" method="post" autocomplete="off">
            <div class="row">
                <div class="col-md-12 mb-1">
                    <input type="hidden" asp-for="BusinessID" />
                    <input type="hidden" asp-for="ContactID" />
                    <label asp-for="BusinessName" class="form-label text-white fw-bold"></label>
                    <input id="cn" asp-for="BusinessName" class="form-control fw-bold">
                    <div><span asp-validation-for="BusinessName" class="text-danger"></span></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <input type="hidden" asp-for="ContactID" />
                    <label asp-for="ContactName" class="form-label text-white fw-bold"></label>
                    <input asp-for="ContactName" class="form-control fw-bold">
                    <div><span asp-validation-for="ContactName" class="text-danger"></span></div>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ContactDesignation" class="form-label text-white fw-bold"></label>
                    <input asp-for="ContactDesignation" class="form-control fw-bold">
                    <div><span asp-validation-for="ContactDesignation" class="text-danger"></span></div>
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="ContactSex" class="form-label text-white fw-bold"></label>
                    <select asp-for="ContactSex" class="form-control fw-bold">
                        <option value=""> - Select - </option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                    <div><span asp-validation-for="ContactSex" class="text-danger"></span></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="ContactPhone1" class="form-label text-white fw-bold"></label>
                    <input asp-for="ContactPhone1" class="form-control fw-bold">
                    <div><span asp-validation-for="ContactPhone1" class="text-danger"></span></div>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="ContactPhone2" class="form-label text-white fw-bold"></label>
                    <input asp-for="ContactPhone2" class="form-control fw-bold">
                    <div><span asp-validation-for="ContactPhone2" class="text-danger"></span></div>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="ContactEmail1" class="form-label text-white fw-bold"></label>
                    <input asp-for="ContactEmail1" class="form-control fw-bold" type="email">
                    <div><span asp-validation-for="ContactEmail1" class="text-danger"></span></div>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="ContactEmail2" class="form-label text-white fw-bold"></label>
                    <input asp-for="ContactEmail2" class="form-control fw-bold" type="email">
                    <div><span asp-validation-for="ContactEmail2" class="text-danger"></span></div>
                </div>
            </div>
            <div class="row">
                <a asp-area="PartnerServices" asp-controller="Suppliers" asp-action="Contacts" asp-route-sp="@Model.BusinessID" class="btn btn-dark ml-1" style="width:100px" title="Return to Contacts">
                    <span class="text-white">Back</span>
                </a>
                @if (!Model.OperationIsCompleted)
                {
                    <a asp-area="PartnerServices" asp-controller="Suppliers" asp-action="EditContact" asp-route-id="@Model.ContactID" class="btn btn-warning ml-1" style="width:100px" title="Refresh">
                        <span class="text-white">Refresh</span>
                    </a>
                    <button type="submit" class="btn btn-info ml-2" title="Save" style="width:200px"><span class="text-white">Save</span></button>
                }
            </div>
        </form>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/js_ptns/ptns_contacts_add.js"></script>
}







