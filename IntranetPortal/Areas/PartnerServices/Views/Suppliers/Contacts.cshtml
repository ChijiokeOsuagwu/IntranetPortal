@model IntranetPortal.Areas.PartnerServices.Models.ContactListViewModel
@{
    ViewData["Title"] = "OfficeManager | Supplier Contacts";
}
<div class="container">
    <h4>Supplier Contacts</h4>
    <hr />
    <div class="mb-1">
        <form asp-area="PartnerServices" asp-controller="Suppliers" asp-action="Contacts" method="get">
            <a asp-area="" asp-controller="Home" asp-action="Apps" class="btn btn-dark pr-2" style="width:100px" title="Exit">
                <span class="text-white">Exit</span>
            </a>
            <a asp-area="PartnerServices" asp-controller="Suppliers" asp-action="List" class="btn btn-dark" style="width:100px" title="Click to Go Back">
                <span class="text-white">Back</span>
            </a>
            <a asp-area="PartnerServices" asp-controller="Suppliers" asp-action="AddContact" asp-route-id="@Model.sp" class="btn btn-success" style="width:200px" title="Add New Contact">
                <span class="text-white">New Contact</span>
            </a>
            <select asp-for="sp" asp-items="@ViewBag.SuppliersList" class="border-0 fw-bold" style="width:300px">
                <option value=""> - Select Supplier - </option>
            </select>
            <input type="submit" value="Search" class="btn btn-dark" style="width:100px" />
        </form>

        @if (!String.IsNullOrEmpty(ViewBag.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold">@ViewBag.ErrorMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>
    @if (Model == null || Model.ContactsList == null || Model.ContactsList.Count < 1)
    {
        <div class="alert alert-info fade show" role="alert">
            <i class="bi bi-info-circle"></i>
            <span class="fw-bold">No record was found.</span>
        </div>
    }
    else
    {
        <div class="row">
            <div class="table-responsive">
                <table class="table table-hover table-sm ">
                    <thead class="table-dark">
                        <tr>
                            <th><span class="text-white fw-bold">Name</span></th>
                            <th><span class="text-white fw-bold">Designation</span></th>
                            <th><span class="text-white fw-bold">Phone No(s)</span></th>
                            <th><span class="text-white fw-bold">Email</span></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody class="table-light">
                        @foreach (var contact in Model.ContactsList)
                        {
                            <tr class="p-0">
                                <td>
                                    <span class="fw-bold">@contact.ContactName</span>
                                </td>
                                <td>
                                    <span class="fw-bold">@contact.Designation</span>
                                </td>
                                <td>
                                    <span class="fw-bold">@contact.ContactPhone1</span>
                                    @if (!string.IsNullOrWhiteSpace(contact.ContactPhone2))
                                    {<span class="fw-bold">, @contact.ContactPhone2</span>}
                                </td>
                                <td>
                                    <span class="fw-bold">@contact.ContactEmail1</span>
                                </td>
                                <td>
                                    <div class="text-center">
                                        <!-- Default dropstart button -->
                                        <div class="btn-group dropstart">
                                            <button type="button" data-bs-toggle="dropdown" aria-expanded="false" class="table-secondary" style="border:0px">
                                                <span class="fw-bold" style="font-size:0.8rem;"><i class="bi bi-tools"></i> Options</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                                <li>
                                                    <a class="dropdown-item" asp-area="PartnerServices" asp-controller="Suppliers" asp-action="ContactDetails" asp-route-id="@contact.ContactID" title="Details">
                                                        <i class="bi bi-info-square"></i><span>Detail</span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" asp-area="PartnerServices" asp-controller="Suppliers" asp-action="EditContact" asp-route-id="@contact.ContactID" title="Edit">
                                                        <i class="bi bi-pencil-square"></i><span>Edit</span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" asp-area="PartnerServices" asp-controller="Suppliers" asp-action="DeleteContact" asp-route-id="@contact.ContactID" title="Edit">
                                                        <i class="bi bi-trash"></i><span>Delete</span>
                                                    </a>
                                                </li>
                                                @*<li>
                                    <a class="dropdown-item" asp-area="PartnerServices" asp-controller="Customers" asp-action="Contacts" asp-route-td="@contact.BusinessID">
                                        <i class="bi bi-people"></i> <span>Contacts</span>
                                    </a>
                                </li>*@
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

