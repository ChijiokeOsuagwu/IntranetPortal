@model IntranetPortal.Areas.PartnerServices.Models.ContactListViewModel
@{
    ViewData["Title"] = "OfficeManager | Customer Contacts";
}
<h4>Customers Management | Customer Contacts</h4>
<hr />
<div class="container">
    <form asp-area="PartnerServices" asp-controller="Customers" asp-action="Contacts" method="get">
        <div class="row">
            <div class="col-md-3 mb-3">
                <a asp-area="PartnerServices" asp-controller="Customers" asp-action="List" class="btn btn-sm btn-dark" style="width:100px" title="Click to Go Back">
                    <span class="text-white">Back</span>
                </a>
            </div>
            <div class="col-md-6 mb-3">
                <select asp-for="sp" asp-items="@ViewBag.CustomersList" class="border-0" style="width:400px">
                    <option value=""> - Select Customer - </option>
                </select>
                <input type="submit" value="Search" class="btn btn-sm btn-dark" style="width:100px; margin-right:10px;" />
            </div>
            <div class="col-md-3 mb-3">
                <a asp-area="PartnerServices" asp-controller="Customers" asp-action="AddContact" asp-route-id="@Model.sp" class="btn btn-sm btn-success" style="width:200px" title="Add New Contact">
                    <span class="text-white">New Contact</span>
                </a>
            </div>
        </div>
    </form>
    @if (!String.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-x-circle"></i>
            <span class="fw-bold">@ViewBag.ErrorMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (Model == null || Model.ContactsList == null || Model.ContactsList.Count < 1)
    {
        <div class="alert alert-info fade show" role="alert">
            <i class="bi bi-info-circle"></i>
            <span class="fw-bold">No record was found.</span>
        </div>
    }
    else
    {
        <div class="row">
            <div class="table-responsive">
                <table class="table table-hover table-sm ">
                    <thead class="table-dark">
                        <tr>
                            <th><span class="text-white fw-bold">Name</span></th>
                            <th><span class="text-white fw-bold">Designation</span></th>
                            <th><span class="text-white fw-bold">Phone No(s)</span></th>
                            <th><span class="text-white fw-bold">Email</span></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody class="table-light">
                        @foreach (var contact in Model.ContactsList)
                        {
                            <tr class="p-0">
                                <td>
                                    <span>@contact.ContactName</span>
                                </td>
                                <td>
                                    <span>@contact.Designation</span>
                                </td>
                                <td>
                                    <span>@contact.ContactPhone1</span>
                                    @if (!string.IsNullOrWhiteSpace(contact.ContactPhone2))
                                    {<span>, @contact.ContactPhone2</span>}
                                </td>
                                <td>
                                    <span>@contact.ContactEmail1</span>
                                </td>
                                <td>
                                    <div class="text-center">
                                        <!-- Default dropstart button -->
                                        <div class="btn-group dropstart">
                                            <button type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border:0px">
                                                <span class="fw-bold" style="font-size:1.0rem;"><i class="bi bi-three-dots"></i></span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                                <li>
                                                    <a class="dropdown-item" asp-area="PartnerServices" asp-controller="Customers" asp-action="ContactDetails" asp-route-id="@contact.ContactID" title="Details">
                                                        <i class="bi bi-info-square"></i><span>Detail</span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" asp-area="PartnerServices" asp-controller="Customers" asp-action="EditContact" asp-route-id="@contact.ContactID" title="Edit">
                                                        <i class="bi bi-pencil-square"></i><span>Edit</span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" asp-area="PartnerServices" asp-controller="Customers" asp-action="DeleteContact" asp-route-id="@contact.ContactID" title="Edit">
                                                        <i class="bi bi-trash"></i><span>Delete</span>
                                                    </a>
                                                </li>
                                                @*<li>
                <a class="dropdown-item" asp-area="PartnerServices" asp-controller="Customers" asp-action="Contacts" asp-route-td="@contact.BusinessID">
                    <i class="bi bi-people"></i> <span>Contacts</span>
                </a>
            </li>*@
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

