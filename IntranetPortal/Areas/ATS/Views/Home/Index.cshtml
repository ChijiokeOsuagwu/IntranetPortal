@{
    ViewData["Title"] = "Assignment Tracking System";
}
<link href="~/lib/matrix/dist/css/style.min.css" rel="stylesheet" />
<div class="my-2">
    <!-- ============================================================== -->
    <!-- Sales Cards  -->
    <!-- ============================================================== -->
    <h4 class="fw-bold">Assignment Tracking System | Home </h4>
    <hr />
    <div class="row">
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="" asp-controller="Home" asp-action="Apps">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-arrow-left-square"></i></h1>
                        <h6 class="text-dark">Go Back</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="ATS" asp-controller="Assignments" asp-action="Active">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-calendar-event"></i></h1>
                        <h6 class="text-dark">Active Assignments</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            @*<a asp-area="ATS" asp-controller="Assignments" asp-action="Search">*@
            <div class="card card-hover">
                <div class="box bg-light text-center">
                    <h1 class="font-light text-dark"><i class="bi bi-search"></i></h1>
                    <h6 class="text-dark">Search Assignments</h6>
                </div>
            </div>
            @*</a>*@
        </div>
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            @*<a asp-area="ATS" asp-controller="Assignment" asp-action="Reports">*@
            <div class="card card-hover">
                <div class="box bg-light text-center">
                    <h1 class="font-light text-dark"><i class="bi bi-file-earmark-text"></i></h1>
                    <h6 class="text-dark"> Reports</h6>
                </div>
            </div>
            @*</a>*@
        </div>
        <!-- Column -->
        <div class="col-md-6 col-lg-2 col-xlg-3">
            <a asp-area="ATS" asp-controller="Home" asp-action="Settings">
                <div class="card card-hover">
                    <div class="box bg-light text-center">
                        <h1 class="font-light text-dark"><i class="bi bi-sliders"></i></h1>
                        <h6 class="text-dark">Settings</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Column -->
    </div>
</div>
@section Scripts{

}



