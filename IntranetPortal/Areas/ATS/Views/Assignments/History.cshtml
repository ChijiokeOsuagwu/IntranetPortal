@model IntranetPortal.Areas.ATS.Models.AssignmentHistoryViewModel
    <div class="container">
        <h4 class="mb-1">Assignment Tracking System | Assignment History </h4>
        <hr />
        <div class="row mb-3">
            <button title="Go Back" class="btn btn-sm btn-dark text-white fw-bold" style="width:75px" onclick="history.back();">
                Back
            </button>
        </div>
        <div class="row">
            @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-x-circle"></i>
                    <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
        <div class="row">
            @if (Model == null || Model.ActivityList == null || Model.ActivityList.Count < 1)
            {
                <div class="alert alert-info fade show" role="alert">
                    <i class="bi bi-info-circle"></i>
                    <span class="fw-bold">No record was found.</span>
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title mb-0">Activity Timeline</h4>
                            </div>
                            <div class="comment-widgets scrollable">
                                @foreach (var activity in Model.ActivityList)
                                {
                                    <!-- Comment Row -->
                                    <div class="d-flex flex-row comment-row mt-0">
                                        <div class="comment-text w-100">
                                            @if (activity.ActivityTime != null)
                                            {
                                                <h6 class="font-medium">@activity.ActivityTime.Value.ToLongDateString() @activity.ActivityTime.Value.ToLongTimeString()</h6>
                                            }
                                            <span class="d-block fw-bold">@activity.ActivityDescription</span>
                                        </div>
                                    </div>
                                    <hr />
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <input type="hidden" asp-for="AssignmentID" />
    </div>

