@model IntranetPortal.Areas.ATS.Models.AddEngReportViewModel
<div class="container">
    <h4>Assignment Tracking System | Post Editing Report </h4>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <a asp-area="ATS" asp-controller="Assignments" asp-action="Active" title="Go Back" class="btn btn-sm btn-success text-white" style="width:75px; border-radius:5px">
                Back
            </a>
        </div>
        <div class="col-md-6 text-end">
        </div>
    </div>
    <hr />
