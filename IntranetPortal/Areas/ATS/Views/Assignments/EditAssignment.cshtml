<div class="card" style="width:80pc">
    <form asp-area="ATS" asp-controller="Assignments" asp-action="EditAssignment" method="post" autocomplete="off">
        <div class="card-header bg-info">
            <div class="row">
                <div class="col-md-6">
                    <span class="text-white" style="font-size:1.2rem; font-weight:bold">Edit Assignment</span>
                </div>
                <div class="col-md-6 text-end">
                    <span class="text-white" style="font-size:1.2rem; font-weight:bold">#</span>
                    <input asp-for="No" class="fw-bold text-white bg-info" style="border:none;" readonly>
                    <div><span asp-validation-for="No" class="text-danger"></span></div>
                </div>
            </div>
        </div>
        <div class="card-body table-secondary">
            @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-x-circle"></i>
                    <span class="fw-bold">@Model.ViewModelErrorMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (!String.IsNullOrEmpty(Model.ViewModelSuccessMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i>
                    <span class="fw-bold">@Model.ViewModelSuccessMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (!String.IsNullOrEmpty(Model.ViewModelWarningMessage))
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle"></i>
                    <span class="fw-bold">@Model.ViewModelWarningMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <div class="row">
                <div class="col-md-9 mb-3">
                    <label class="form-label text-dark">Client/Organisation*</label>
                    <input id="cn" asp-for="ClientName" class="form-control fw-bold" autofocus>
                    <div><span asp-validation-for="ClientName" class="text-danger"></span></div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label text-dark">Approval Status</label>
                    <select asp-for="ApprovalStatus" class="form-control fw-bold">
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="Not Approved">Not Approved</option>
                    </select>
                    <div><span asp-validation-for="ApprovalStatus" class="text-danger"></span></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label class="form-label text-dark">Event Title*</label>
                    <input asp-for="Title" class="form-control fw-bold">
                    <div><span asp-validation-for="Title" class="text-danger"></span></div>
                </div>
                <div class="col-md-4 mb-3">
