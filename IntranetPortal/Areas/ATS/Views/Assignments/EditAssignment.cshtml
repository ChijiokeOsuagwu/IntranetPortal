                        <option value="">Select</option>
                    </select>
                    <div><span asp-validation-for="EventTypeId" class="text-danger"></span></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label text-dark">Event Venue*</label>
