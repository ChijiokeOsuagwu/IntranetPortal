@model IntranetPortal.Areas.ATS.Models.AddParticipationReportViewModel
<div class="container">
    <h4>Assignment Tracking System | Crew Report </h4>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <a asp-area="ATS" asp-controller="Assignments" asp-action="Active" title="Go Back" class="btn btn-sm btn-info text-white" style="width:75px; border-radius:5px">
                Back
            </a>
        </div>
        <div class="col-md-6 text-end">
        </div>
    </div>
    <hr />
    @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="margin-top:3px">
            <i class="bi bi-x-circle"></i>
            <span class="fw-bold">@Model.ViewModelErrorMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="row">
        <div class="card" style="width:80pc">
            <form asp-area="ATS" asp-controller="Assignments" asp-action="AddParticipationReport" method="post" autocomplete="off">
                <div class="card-header bg-info">
                    <div class="row">
                        <div class="col-md-4">
                            <span class="fw-bold text-white" style="font-size:1.1rem">Crew Report </span>
                        </div>
                        <div class="col-md-8 text-end">
                            <input asp-for="EmployeeName" class="fw-bold text-white bg-info" style="font-size:1.1rem; border:none" readonly />
                        </div>
                    </div>
                </div>
                <div class="card-body table-secondary">
                    <div class="row">
                        <div class="col-md-9 mb-3" title="Assignment Title">
                            <label class="form-label text-dark">Assignment Title</label>
                            <input class="form-control fw-bold" asp-for="AssignmentTitle" readonly />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label text-dark">Attendance Status</label>
                            <select asp-for="AttendanceStatus" class="form-select fw-bold">
                                <option value=""> Select </option>
                                <option value="Present (On Time)"> Present (On Time)</option>
                                <option value="Present (Late)"> Present (Late)</option>
                                <option value="Absent "> Absent </option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 mb-1">
                            <label class="form-label text-dark">Arrival Date</label>
                            <input asp-for="ArrivalDate" class="form-control fw-bold" type="date">
                            <div><span asp-validation-for="ArrivalDate" class="text-danger"></span></div>
                        </div>
                        <div class="col-md-3 mb-1">
                            <label class="form-label text-dark">Arrival Time</label>
                            <div class="input-group">
                                <select asp-for="ArrivalHour" class="form-select fw-bold">
                                    <option value="0">00</option>
                                    <option value="1">1</option>
                                    <option value="2">2</option>
                                    <option value="3">3</option>
                                    <option value="4">4</option>
                                    <option value="5">5</option>
                                    <option value="6">6</option>
                                    <option value="7">7</option>
                                    <option value="8">8</option>
                                    <option value="9">9</option>
                                    <option value="10">10</option>
                                    <option value="11">11</option>
                                    <option value="12">12</option>
                                </select>
