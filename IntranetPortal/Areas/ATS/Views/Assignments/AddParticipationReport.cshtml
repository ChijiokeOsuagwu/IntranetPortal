                                    <option value="55">55</option>
                                    <option value="56">56</option>
                                    <option value="57">57</option>
                                    <option value="58">58</option>
                                    <option value="59">59</option>
                                </select>
                                <select asp-for="DepartureAmPm" class="form-select fw-bold">
                                    <option value="AM">AM</option>
                                    <option value="PM">PM</option>
                                    <option value=""></option>
                                </select>
                            </div>
                            <div><span asp-validation-for="DepartureHour" class="text-danger"></span></div>
                            <div><span asp-validation-for="DepartureMinute" class="text-danger"></span></div>
                            <div><span asp-validation-for="DepartureAmPm" class="text-danger"></span></div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label text-dark">Arrival Type</label>
                            <select asp-for="ArrivalType" class="form-select fw-bold">
                                <option value=""> Select </option>
                                <option value="Arrived with the Crew"> Arrived with the Crew </option>
                                <option value="Arrived Separately"> Arrived Separately</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label text-dark">Departure Type</label>
                            <select asp-for="DepartureType" class="form-select fw-bold">
                                <option value=""> Select </option>
                                <option value="Departed with the Crew"> Departed with the Crew </option>
                                <option value="Departed Separately"> Departed Separately</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input asp-for="HasIncidents" id="chx_incidents" class="form-check-input" type="checkbox" style="width:17px; height:17px; margin-top:15px;" onchange="toggleIncidentInputVisibility()">
                                <label class="form-check-label" for="HasIncidents" style="margin-top:15px">
                                    Include Incident Reports
                                </label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input asp-for="HasFeedback" id="chx_feedback" class="form-check-input" type="checkbox" style="width:17px; height:17px; margin-top:15px;" onchange="toggleFeedbackInputVisibility()">
                                <label class="form-check-label" for="HasFeedback" style="margin-top:15px;">
                                    Include Feedback Report
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="row" id="div_incident_details" hidden>
                        <div class="col-md-12 mb-3">
                            <label class="form-label text-dark">Incident Details</label>
                            <textarea class="form-control fw-bold" id="txtincident" asp-for="IncidenceDetails" placeholder="Enter Incident Details Here ..." rows="3">@Model.IncidenceDetails</textarea>
                        </div>
                    </div>
                    <div class="row" id="div_feedback_details" hidden>
                        <div class="col-md-12 mb-3">
                            <label class="form-label text-dark">Feedback/Recommendation</label>
                            <textarea class="form-control fw-bold" id="txtfeedback" asp-for="FeedbackDetails" placeholder="Enter Feedback or Recommendation Here ..." rows="3">@Model.FeedbackDetails</textarea>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 text-end">
                            <a asp-area="ATS" asp-controller="Assignments" asp-action="AddParticipationReport" asp-route-id="@Model.AssignmentId" style="width:75px; border-radius:5px; margin-right:5px" class="btn btn-sm btn-dark" title="Clear">
                                <span> Clear</span>
                            </a>
                            <button type="submit" class="btn btn-sm btn-info" title="Save" style="width:100px; border-radius:5px"><span class="text-white">Save</span></button>
                        </div>
                    </div>
                    <input type="hidden" asp-for="EmployeeId" />
                    <input type="hidden" asp-for="AssignmentId" />
                    <input type="hidden" asp-for="CrewReportId" />
                    <input type="hidden" asp-for="IsTeamLead" />
                    <input type="hidden" asp-for="AssignmentCrewId" />
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/ats.js"></script>
}
