@model IntranetPortal.Areas.ATS.Models.ActiveAssignmentsListViewModel
<div class="container">
    <h4 class="mb-1">Assignment Tracking System | Active Assignments </h4>
    <hr />
    <div class="row">
        <div class="col-md-2">
            <a asp-area="ATS" asp-controller="Home" asp-action="Index" title="Go Back" class="btn btn-sm btn-info text-white" style="width:75px; border-radius:5px">
                Back
            </a>
        </div>
        <div class="col-md-8">
            <span class="fw-bold">From: </span>
            <input asp-for="sd" class="border-0" style="width:100px; margin-right:30px" type="date" />
            <span class="fw-bold">To: </span>
            <input asp-for="ed" class="border-0" style="width:100px; margin-right:30px" type="date" />
            <select style="width:300px; border:none">
                <option value="">All</option>
                <option value="Pending Coverage"> Pending Coverage </option>
                <option value="Coverage Completed"> Coverage Completed </option>
                <option value="Pending Editing"> Pending Editing </option>
                <option value="Editing Completed"> Editing Completed </option>
                <option value="Ready for Broadcast"> Ready for Broadcast </option>
                <option value="Used In Broadcast"> Used In Broadcast </option>
                <option value="Suspended"> Suspended </option>
                <option value="Cancelled"> Cancelled </option>
            </select>
            <input type="submit" value="Search" class="btn btn-sm btn-info" style="width:100px; margin-right:20px; border-radius:5px" />
        </div>
        <div class="col-md-2">
            <a asp-area="ATS" asp-controller="Assignments" asp-action="CreateNew" title="Create New Assignment" class="btn btn-sm btn-info text-white">
                <i class="bi bi-plus-lg fw-bolder" style="font-size: 0.8rem; font-weight:900; margin-right:5px"></i><span style="font-size: 0.8rem; border-radius:5px">New Assignment</span>
            </a>
        </div>
    </div>
    <hr />
    @if (!String.IsNullOrEmpty(Model.ViewModelErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="margin-top:3px">
            <i class="bi bi-x-circle"></i>
            <span class="fw-bold">@Model.ViewModelErrorMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="row mt-2">
        @if (Model == null || Model.AssignmentList == null || Model.AssignmentList.Count < 1)
        {
            <div class="alert alert-secondary alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold text-dark">No record was found.</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else
        {
            int row_number = 0;
            <div class="table-responsive">
                @foreach (var assignment in Model.AssignmentList)
                {
                    row_number++;
                    <div class="card" style="width:80pc">
                        @if (assignment.ProgressStatus == "Cancelled")
                        {
                            <div class="card-header bg-danger">
                                <div class="row">
                                    <div class="col-md-3" title="Assigned To">
                                        @if (string.IsNullOrWhiteSpace(assignment.AssignedToName))
                                        {
                                            <span class="fw-bold text-white" title="Assigned To"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> [Not Yet Assigned] </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Assigned To"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> @assignment.AssignedToName</span>
                                        }
                                    </div>
                                    <div class="col-md-2" title="Event Location">
                                        <span class="fw-bold text-white" title="Event Location"><i class="bi bi-geo-alt" style="font-size:1.2rem; font-weight:bold"></i> @assignment.EventState</span>
                                    </div>
                                    <div class="col-md-4" title="Event Date and Time">
                                        @if (assignment.EventStartTime == null)
                                        {
                                            <span class="fw-bold text-white" title="Event Date and Time"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> [Unspecified]</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Event Date and Time"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> @assignment.EventStartTime.Value.ToString("f")</span>
                                        }
                                    </div>
                                    <div class="col-md-3 text-end" title="Assignment Status">
                                        <span class="fw-bold" style="color:white" title="Assignment Status"><i class="bi bi-speedometer2" style="font-size:1.0rem; font-weight:bold"></i> @assignment.ProgressStatus</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="card-header bg-info">
                                <div class="row">
                                    <div class="col-md-4" title="Assigned To">
                                        @if (string.IsNullOrWhiteSpace(assignment.AssignedToName))
                                        {
                                            <span class="fw-bold text-white" title="Assigned To"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> [Not Yet Assigned] </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Assigned To"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> @assignment.AssignedToName</span>
                                        }
                                    </div>
                                    <div class="col-md-2" title="Event Location">
                                        <span class="fw-bold text-white" title="Event Location"><i class="bi bi-geo-alt" style="font-size:1.2rem; font-weight:bold"></i> @assignment.EventState</span>
                                    </div>
                                    <div class="col-md-4" title="Event Date and Time">
                                        @if (assignment.EventStartTime == null)
                                        {
                                            <span class="fw-bold text-white" title="Event Date and Time"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> [Unspecified]</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Event Date and Time"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> @assignment.EventStartTime.Value.ToString("f")</span>
                                        }
                                    </div>
                                    <div class="col-md-2" title="Assignment Status">
                                        <span class="fw-bold" style="color:white" title="Assignment Status"><i class="bi bi-speedometer2" style="font-size:1.0rem; font-weight:bold"></i> @assignment.ProgressStatus</span>
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="card-body table-secondary">
                            <div class="row">
                                <div class="col-md-2" title="Assignment Number">
                                    <label class="form-label text-dark">#</label>
                                    <div class="form-control fw-bold">@assignment.No</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label text-dark">Client/Organisation</label>
                                    <div class="form-control fw-bold">@assignment.ClientName</div>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label text-dark">Assigned To</label>
                                    <div class="form-control fw-bold">@assignment.AssignedToName</div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-9 mb-3">
                                    <label class="form-label text-dark">Event Title</label>
                                    <div class="form-control fw-bold">@assignment.Title</div>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label text-dark">Approval Status</label>
                                    <div class="form-control fw-bold">@assignment.ApprovalStatus</div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="row">
                                        <div class="col-md-3 text-center" style="margin-top:10px">
                                            @if (@assignment.IsPaid)
                                            {<i class="bi bi-check-square" style="font-size:1.0rem;"></i><span>  Is Paid</span>}
                                            else
                                            { <i class="bi bi-square" style="font-size:1.0rem;"></i><span>  Is Paid</span>}
                                        </div>
                                        <div class="col-md-3 text-center" style="margin-top:10px">
                                            @if (@assignment.IsConfirmed)
                                            {<i class="bi bi-check-square" style="font-size:1.0rem"></i><span>  Is Confirmed</span>}
                                            else
                                            { <i class="bi bi-square" style="font-size:1.0rem"></i><span>  Is Confirmed</span>}

                                        </div>
                                        <div class="col-md-3 text-center" style="margin-top:10px">
                                            @if (@assignment.IsLive)
                                            {<i class="bi bi-check-square" style="font-size:1.0rem"></i><span style="font-size:0.8rem">  Is Live</span>}
                                            else
                                            { <i class="bi bi-square" style="font-size:1.0rem"></i><span style="font-size:0.8rem">  Is Live</span>}
                                        </div>
                                        <div class="col-md-3 text-center" style="margin-top:10px">
                                            @if (@assignment.IsPriority)
                                            {<span style="font-size:0.8rem"><i class="bi bi-check-square fw-bold" style="font-size:1.0rem"></i>  Is Priority</span>}
                                            else
                                            { <i class="bi bi-square" style="font-size:1.0rem"></i><span style="font-size:0.8rem"> Is Priority</span>}
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 text-end">
                                    <!-- Default dropstart button -->
                                    <div class="btn-group dropstart" style="margin-right:10px">
                                        <button type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius:5px; border:0px" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-file-earmark-text" style="font-size:1.0rem; font-weight:900"></i><span class="fw-bold"> Submit Report</span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="bi bi-box-arrow-in-left"></i> <span>Crew Reports</span>
                                                </a>
                                                <ul class="dropdown-menu dropdown-menu-dark dropdown-submenu">
                                                    <li>
                                                        <a class="dropdown-item" asp-area="ATS" asp-controller="Assignments" asp-action="CrewReports" asp-route-id="@assignment.Id" asp-route-tl="@assignment.Title">
                                                            <i class="bi bi-file-earmark-text"></i>  <span>View Reports</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="ATS" asp-controller="Assignments" asp-action="AddParticipationReport" asp-route-id="@assignment.Id">
                                                            <i class="bi bi-file-earmark-text"></i>  <span>Submit Report</span>
                                                        </a>
                                                    </li>
                                                </ul>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="bi bi-box-arrow-in-left"></i> <span>ENG Report</span>
                                                </a>
                                                <ul class="dropdown-menu dropdown-menu-dark dropdown-submenu">
                                                    <li>
                                                        <a class="dropdown-item" asp-area="ATS" asp-controller="Assignments" asp-action="EngReports" asp-route-id="@assignment.Id" asp-route-tl="@assignment.Title">
                                                            <i class="bi bi-file-earmark-text"></i>  <span>View Report</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="ATS" asp-controller="Assignments" asp-action="AddEngReport" asp-route-id="@assignment.Id">
                                                            <i class="bi bi-file-earmark-text"></i>  <span>Submit Report</span>
                                                        </a>
                                                    </li>
                                                </ul>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="bi bi-box-arrow-in-left"></i> <span>Coordinator's Report</span>
                                                </a>
                                                <ul class="dropdown-menu dropdown-menu-dark dropdown-submenu">
                                                    <li>
                                                        <a class="dropdown-item" asp-area="ATS" asp-controller="Assignments" asp-action="CoordReports" asp-route-id="@assignment.Id" asp-route-tl="@assignment.Title">
                                                            <i class="bi bi-file-earmark-text"></i>  <span>View Report</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="ATS" asp-controller="Assignments" asp-action="AddCoordReport" asp-route-id="@assignment.Id">
                                                            <i class="bi bi-file-earmark-text"></i>  <span>Submit Report</span>
                                                        </a>
                                                    </li>
                                                </ul>
                                            </li>
                                        </ul>
                                    </div>
                                    <a asp-area="ATS" asp-controller="Assignments" asp-action="CrewList" asp-route-id="@assignment.Id" asp-route-tl="@assignment.Title" asp-route-lc="@assignment.EventState" style="border-radius:5px; border:0px; margin-right:10px" class="btn btn-sm btn-outline-info" title="Manage Crew List">
                                        <i class="bi bi-people" style="font-size:1.0rem"></i> <span class="fw-bold"> Manage Crew</span>
                                    </a>
                                    <a asp-area="ATS" asp-controller="Assignments" asp-action="EquipmentList" asp-route-id="@assignment.Id" asp-route-tl="@assignment.Title" asp-route-lc="@assignment.EventState" style="border-radius:5px; border:0px; margin-right:10px" class="btn btn-sm btn-outline-info" title="Manage Equipment">
                                        <i class="bi bi-mic" style="font-size:1.0rem"></i> <span class="fw-bold"> Manage Equipment</span>
                                    </a>
                                    <!-- Default dropstart button -->
                                    <div class="btn-group dropstart" style="margin-right:10px">
                                        <button type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius:5px; border:0px" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-tools" style="font-size:1.0rem; font-weight:900"></i><span class="fw-bold"> Options</span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="bi bi-box-arrow-in-left"></i> <span>Reports</span>
                                                </a>
                                                <ul class="dropdown-menu dropdown-menu-dark dropdown-submenu">
                                                    <li>
                                                        <a class="dropdown-item" asp-area="ATS" asp-controller="Assignments" asp-action="CrewReports" asp-route-id="@assignment.Id" asp-route-tl="@assignment.Title">
                                                            <i class="bi bi-file-earmark-text"></i>  <span>View Participation Reports</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="ATS" asp-controller="Assignments" asp-action="EngReports" asp-route-id="@assignment.Id" asp-route-tl="@assignment.Title">
                                                            <i class="bi bi-file-earmark-text"></i>  <span>View Post Editing Report</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="ATS" asp-controller="Assignments" asp-action="AddParticipationReport" asp-route-id="@assignment.Id">
                                                            <i class="bi bi-file-earmark-text"></i>  <span>Submit Participation Report</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="ATS" asp-controller="Assignments" asp-action="AddEngReport" asp-route-id="@assignment.Id">
                                                            <i class="bi bi-file-earmark-text"></i>  <span>Submit Post Editing Report</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="ATS" asp-controller="Assignments" asp-action="AddCoordinatorReport" asp-route-id="@assignment.Id">
                                                            <i class="bi bi-file-earmark-text"></i>  <span>Submit Coordinator's Report</span>
                                                        </a>
                                                    </li>
                                                </ul>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-area="ATS" asp-controller="Assignments" asp-action="History" asp-route-id="@assignment.Id">
                                                    <i class="bi bi-file-text"></i> <span>History</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-area="ATS" asp-controller="Assignments" asp-action="Notes" asp-route-id="@assignment.Id" asp-route-sp="ctv">
                                                    <i class="bi bi-stickies"></i> <span>Notes</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-area="ATS" asp-controller="Assignments" asp-action="Details" asp-route-id="@assignment.Id">
                                                    <i class="bi bi-info-square"></i>  <span>Details</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-area="ATS" asp-controller="Assignments" asp-action="EditAssignment" asp-route-id="@assignment.Id">
                                                    <i class="bi bi-pencil-fill"></i>  <span>Edit</span>
                                                </a>
                                            </li>
                                            <li>
                                                <button class="dropdown-item" id="btn_delete_@assignment.Id" onclick="deleteAssignment(@assignment.Id)">
                                                    <i class="bi bi-trash-fill"></i> <span>Delete</span>
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
@section Scripts{
    <script src="~/js/ats.js"></script>
}
