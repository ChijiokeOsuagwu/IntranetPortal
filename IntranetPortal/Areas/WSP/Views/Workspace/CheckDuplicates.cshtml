@model IntranetPortal.Areas.WSP.Models.CheckDuplicatesViewModel
<div class="container">
    <h5 class="mb-1">Check Duplicates </h5>
    <hr />
    <div class="row">
            <div class="col-md-4 fw-bold"><span style="font-size:1.0rem">Name: @Model.TaskOwnerName</span></div>
            <div class="col-md-4 fw-bold"><span style="font-size:0.9rem">Unit: @Model.TaskOwnerUnit</span></div>
            <div class="col-md-4 fw-bold"><span style="font-size:0.9rem">Location: @Model.TaskOwnerLocation</span></div>
        </div>
    <hr />
   
    <form asp-area="WSP" asp-controller="Workspace" asp-action="CheckDuplicates" method="get">
        <div class="row">
            <div class="col-md-2">
                @if (Model.TaskItemList != null)
                {
                    <span class="fw-bold">Records: (@Model.TaskItemList.Count.ToString())</span>
                }
                else
                {
                    <span class="fw-bold">Records: (0)</span>
                }
            </div>
            <div class="col-md-10 mb-3">
                <span class="fw-bold">Search For: </span>
                <input asp-for="kw" class="border-0 fw-bold" placeholder="Enter Keyword" style="margin-right:30px;" autocomplete="off" />
                <span class="fw-bold">Start From: </span>
                <input asp-for="sd" class="border-0" style="width:100px; margin-right:30px" type="date" />
                <span class="fw-bold">End On: </span>
                <input asp-for="ed" class="border-0" style="width:100px; margin-right:30px" type="date" />
                <input type="submit" value="Search" class="btn btn-dark btn-sm text-white" style="width:100px" />
            </div>
        </div>
            </form>
       <div class="row">
        @if (!string.IsNullOrWhiteSpace(Model.ViewModelErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold text-dark">@Model.ViewModelErrorMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="row">
        @if (Model == null || Model.TaskItemList == null || Model.TaskItemList.Count < 1)
        {
            <div class="alert alert-secondary alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle"></i>
                <span class="fw-bold text-dark">No record was found.</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else
        {
            int row_number = 0;
            <div class="table-responsive">
                @foreach (var task in Model.TaskItemList)
                {
                    row_number++;
                    <div class="card">
                        @if (task.ApprovalStatus == ApprovalStatus.Declined)
                        {
                            <div class="card-header" style="background-color:#D11604">
                                <div class="row">
                                    <div class="col-md-5" title="Assigned By">
                                        @if (string.IsNullOrWhiteSpace(task.AssignedByEmployeeName))
                                        {
                                            <span class="fw-bold text-white" title="Assigned By"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> @task.CreatedBy </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Assigned By"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> @task.AssignedByEmployeeName</span>
                                        }
                                    </div>
                                    <div class="col-md-4" title="Time Assigned">
                                        @if (task.AssignedTime == null)
                                        {
                                            <span class="fw-bold text-white" title="Time Assigned"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> @task.CreatedTime.Value.ToString("dd-MMM-yyyy ")   @task.CreatedTime.Value.ToShortTimeString()</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Time Assigned"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> @task.AssignedTime.Value.ToString("dd-MMM-yyyy ")   @task.AssignedTime.Value.ToShortTimeString()</span>
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        @if (task.ProgressStatus == WorkItemProgressStatus.Completed)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-check-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i> Completed
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.InProgress)
                                        {
                                            <div class="fw-bold" style="font-size:1.0rem; color:white">
                                                <i class="bi bi-clock-history" style="color:white; font-size:1.0rem; font-weight:bold"></i>  In Progress
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.OnHold)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-slash-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i>  On Hold
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.NotStarted)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-dash-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i> Not Started
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fw-bold" style="font-size:1.0rem">
                                                <i class="bi bi-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i>  [N/A]
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else if (task.ApprovalStatus == ApprovalStatus.Approved)
                        {
                            <div class="card-header bg-info">
                                <div class="row">
                                    <div class="col-md-5" title="Assigned By">
                                        @if (string.IsNullOrWhiteSpace(task.AssignedByEmployeeName))
                                        {
                                            <span class="fw-bold text-white" title="Assigned By"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> @task.CreatedBy </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Assigned By"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> @task.AssignedByEmployeeName</span>
                                        }
                                    </div>
                                    <div class="col-md-4" title="Time Assigned">
                                        @if (task.AssignedTime == null)
                                        {
                                            <span class="fw-bold text-white" title="Time Assigned"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> @task.CreatedTime.Value.ToString("dd-MMM-yyyy ")   @task.CreatedTime.Value.ToShortTimeString()</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Time Assigned"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> @task.AssignedTime.Value.ToString("dd-MMM-yyyy ")   @task.AssignedTime.Value.ToShortTimeString()</span>
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        @if (task.ProgressStatus == WorkItemProgressStatus.Completed)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-check-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i> Completed
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.InProgress)
                                        {
                                            <div class="fw-bold" style="font-size:1.0rem; color:white">
                                                <i class="bi bi-clock-history" style="color:white; font-size:1.0rem; font-weight:bold"></i>  In Progress
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.OnHold)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-slash-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i>  On Hold
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.NotStarted)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-dash-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i> Not Started
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fw-bold" style="font-size:1.0rem">
                                                <i class="bi bi-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i>  [N/A]
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="card-header bg-dark">
                                <div class="row">
                                    <div class="col-md-5" title="Assigned By">
                                        @if (string.IsNullOrWhiteSpace(task.AssignedByEmployeeName) || task.AssignedByEmployeeName == task.TaskOwnerName)
                                        {
                                            <span class="fw-bold text-white" title="Assigned By"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> @task.CreatedBy </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Assigned By"><i class="bi bi-person" style="font-size:1.2rem; font-weight:bold"></i> @task.AssignedByEmployeeName</span>
                                        }
                                    </div>
                                    <div class="col-md-4" title="Time Assigned">
                                        @if (task.AssignedTime == null)
                                        {
                                            <span class="fw-bold text-white" title="Time Assigned"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> @task.CreatedTime.Value.ToString("dd-MMM-yyyy ")   @task.CreatedTime.Value.ToShortTimeString()</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-white" title="Time Assigned"><i class="bi bi-clock" style="font-size:1.0rem; font-weight:bold"></i> @task.AssignedTime.Value.ToString("dd-MMM-yyyy ")   @task.AssignedTime.Value.ToShortTimeString()</span>
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        @if (task.ProgressStatus == WorkItemProgressStatus.Completed)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-check-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i> Completed
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.InProgress)
                                        {
                                            <div class="fw-bold" style="font-size:1.0rem; color:white">
                                                <i class="bi bi-clock-history" style="color:white; font-size:1.0rem; font-weight:bold"></i>  In Progress
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.OnHold)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-slash-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i>  On Hold
                                            </div>
                                        }
                                        else if (task.ProgressStatus == WorkItemProgressStatus.NotStarted)
                                        {
                                            <div class="fw-bold" style="color:white">
                                                <i class="bi bi-dash-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i> Not Started
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fw-bold" style="font-size:1.0rem">
                                                <i class="bi bi-circle" style="color:white; font-size:1.0rem; font-weight:bold"></i>  [N/A]
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="card-body table-secondary">
                            <div class="row">
                                <div class="col-md-2 mb-3">
                                    <label class="form-label text-dark">Task No.</label>
                                    <input asp-for="@task.Number" class="form-control fw-bold" readonly="readonly">
                                </div>
                                <div class="col-md-2 mb-3">
                                    <label class="form-label text-dark">Expected Start Date</label>
                                    @if (task.ExpectedStartTime != null)
                                    {
                                        <div class="form-control fw-bold">@task.ExpectedStartTime.Value.ToString("dd-MMM-yyyy")</div>
                                    }
                                    else
                                    {
                                        <div class="form-control fw-bold">[Not Specified]</div>
                                    }
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label text-dark">Actual Start Date</label>
                                    @if (task.ActualStartTime != null)
                                    {
                                        <div class="form-control fw-bold">@task.ActualStartTime.Value.ToString("dd-MMM-yyyy")</div>
                                    }
                                    else
                                    {
                                        <div class="form-control fw-bold">[Not Specified]</div>
                                    }
                                </div>
                                <div class="col-md-2 mb-3">
                                    <label class="form-label text-dark">Expected Completion Date</label>
                                    @if (task.ExpectedDueTime != null)
                                    {
                                        <div class="form-control fw-bold">@task.ExpectedDueTime.Value.ToString("dd-MMM-yyyy")</div>
                                    }
                                    else
                                    {
                                        <div class="form-control fw-bold">[Not Specified]</div>
                                    }
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label text-dark">Actual Completion Date</label>
                                    @if (task.ActualDueTime != null)
                                    {
                                        <div class="form-control fw-bold">@task.ActualDueTime.Value.ToString("dd-MMM-yyyy")</div>
                                    }
                                    else
                                    {
                                        <div class="form-control fw-bold">[Not Specified]</div>
                                    }
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label text-dark">Description</label>
                                    <textarea asp-for="@task.Description" class="form-control fw-bold" readonly="readonly">@task.Description</textarea>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(task.MoreInformation))
                            {
                                <div class="row">
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label text-dark">Resolution</label>
                                        <textarea asp-for="@task.MoreInformation" class="form-control fw-bold" readonly="readonly">@task.MoreInformation</textarea>
                                    </div>
                                </div>
                            }
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-dark">Folder Title</label>
                                <input asp-for="@task.WorkFolderName" class="form-control fw-bold" readonly="readonly" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-dark">Folder Title</label>
                                <input asp-for="@task.WorkFolderName" class="form-control fw-bold" readonly="readonly" />
                            </div>
                        </div>
                            <div class="row">
                                <div class="col-md-4 mt-1 text-center">
                                    @if (task.ApprovalStatus == ApprovalStatus.Approved)
                                    {
                                        <div class="fw-bold text-dark">
                                            <i class="bi bi-check-circle" style="font-size:1.0rem; font-weight:bold"></i> Approved
                                        </div>
                                    }
                                    else if (task.ApprovalStatus == ApprovalStatus.Declined)
                                    {
                                        <div class="fw-bold text-dark">
                                            <i class="bi bi-x-circle" style="font-size:1.0rem; font-weight:bold"></i> Approval Declined
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-dark">
                                            <i class="bi bi-dash-circle" style="font-size:1.0rem; font-weight:bold"></i> Pending Approval
                                        </div>
                                    }
                                </div>
                                <div class="col-md-8 mt-1 text-end">
                                        <!-- Default dropstart button -->
                                        <div class="btn-group dropstart">
                                            <button type="button" data-bs-toggle="dropdown" aria-expanded="false" class="table-secondary" style="border:0px">
                                                <span class="fw-bold" style="font-size:0.8rem;"><i class="bi bi-tools"></i> Options</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
                                                <li>
                                                    <a class="dropdown-item" asp-area="WSP" asp-controller="Workspace" asp-action="TaskDetails" asp-route-id="@task.Id">
                                                        <i class="bi bi-info-circle"></i>  <span>Detail</span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" asp-area="WSP" asp-controller="Workspace" asp-action="Notes" asp-route-td="@task.Id" asp-route-fd="@task.WorkFolderId" asp-route-sp="mtl" asp-route-tp="0">
                                                        <i class="bi bi-stickies"></i> <span>Notes</span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" asp-area="WSP" asp-controller="Workspace" asp-action="Activities" asp-route-td="@task.Id">
                                                        <i class="bi bi-file-text"></i> <span>History</span>
                                                    </a>
                                                </li>
                                                @* <li><hr class="dropdown-divider"></li>
        <li>
             <button class="dropdown-item" id="btn_delete_@task.Id" onclick="deleteTaskItem('@task.Id')">
                 <i class="bi bi-trash"></i> <span> Delete</span>
             </button>
         </li>*@
                                            </ul>
                                        </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
@section Scripts{
    <script src="~/js/wsp.js"></script>
}
